#!/usr/bin/env rumiai-os

extract_have()
{
  [ "$#" -eq 1 ] || return 2
  command -v -- "$1" >/dev/null 2>&1
}

extract_require()
{
  [ "$#" -eq 1 ] || return 2
  extract_have "$1" && return 0
  fatal execution command-not-found operation extract command "$1" format "$extract_format"
}

extract_stream_target()
{
  [ "$#" -eq 2 ] || return 2
  extract_stream_name=$1
  extract_stream_format=$2

  case "$extract_stream_format:$extract_stream_name" in
    gzip:*.gz|gz:*.gz) extract_stream_name=${extract_stream_name%.gz};;
    gzip:*.gzip|gz:*.gzip) extract_stream_name=${extract_stream_name%.gzip};;
    bzip:*.bz2|bzip2:*.bz2|bz2:*.bz2) extract_stream_name=${extract_stream_name%.bz2};;
    bzip:*.bz|bzip2:*.bz|bz2:*.bz) extract_stream_name=${extract_stream_name%.bz};;
    bzip:*.bzip2|bzip2:*.bzip2|bz2:*.bzip2) extract_stream_name=${extract_stream_name%.bzip2};;
    xz:*.xz) extract_stream_name=${extract_stream_name%.xz};;
    zstd:*.zst|zst:*.zst) extract_stream_name=${extract_stream_name%.zst};;
    zstd:*.zstd|zst:*.zstd) extract_stream_name=${extract_stream_name%.zstd};;
    *) return 1;;
  esac

  [ -n "$extract_stream_name" ] && [ "$extract_stream_name" != . ] && [ "$extract_stream_name" != .. ] || return 1
  printf -- '%s\n' "$extract_stream_name"
}

extract_tar_stream()
{
  extract_require tar
  (
    cd -- "$extract_destination" || exit 1
    TAR_OPTIONS= command -- tar -xf -
  ) < "$extract_artifact"
}

extract_compressed_tar()
{
  extract_compressor=$1
  extract_require "$extract_compressor"
  extract_require tar

  extract_tmp="$extract_destination/.extract-$$.tar"
  [ ! -e "$extract_tmp" ] && [ ! -L "$extract_tmp" ] || fatal execution execution-failed operation extract reason temporary-target-exists format "$extract_format"

  case "$extract_compressor" in
    gzip)
      GZIP= command -- gzip -dc < "$extract_artifact" > "$extract_tmp"
      ;;
    bzip2)
      BZIP2= BZIP= command -- bzip2 -dc < "$extract_artifact" > "$extract_tmp"
      ;;
    xz)
      XZ_OPT= XZ_DEFAULTS= command -- xz -dc < "$extract_artifact" > "$extract_tmp"
      ;;
    zstd)
      command -- zstd -dcq < "$extract_artifact" > "$extract_tmp"
      ;;
    *)
      fatal 2 execution invalid-arguments operation extract
      ;;
  esac
  extract_status=$?
  if [ "$extract_status" -ne 0 ]
  then
    command -p -- rm -f -- "$extract_tmp" 2>/dev/null
    fatal execution execution-failed operation extract reason decompression-failed format "$extract_format"
  fi

  exec 3< "$extract_tmp" || {
    command -p -- rm -f -- "$extract_tmp" 2>/dev/null
    fatal execution execution-failed operation extract reason temporary-read-failed format "$extract_format"
  }
  command -p -- rm -f -- "$extract_tmp" || {
    exec 3<&-
    fatal execution execution-failed operation extract reason temporary-cleanup-failed format "$extract_format"
  }

  (
    cd -- "$extract_destination" || exit 1
    TAR_OPTIONS= command -- tar -xf - <&3
  )
  extract_status=$?
  exec 3<&-
  [ "$extract_status" -eq 0 ] || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
}

extract_stream()
{
  extract_compressor=$1
  extract_require "$extract_compressor"

  extract_stream_base=${extract_artifact##*/}
  extract_stream_name="$(extract_stream_target "$extract_stream_base" "$extract_format")" || fatal execution execution-failed operation extract reason output-name-invalid format "$extract_format"
  extract_stream_output="$extract_destination/$extract_stream_name"
  [ ! -e "$extract_stream_output" ] && [ ! -L "$extract_stream_output" ] || fatal execution execution-failed operation extract reason output-exists format "$extract_format"

  case "$extract_compressor" in
    gzip)
      GZIP= command -- gzip -dc < "$extract_artifact" > "$extract_stream_output"
      ;;
    bzip2)
      BZIP2= BZIP= command -- bzip2 -dc < "$extract_artifact" > "$extract_stream_output"
      ;;
    xz)
      XZ_OPT= XZ_DEFAULTS= command -- xz -dc < "$extract_artifact" > "$extract_stream_output"
      ;;
    zstd)
      command -- zstd -dcq < "$extract_artifact" > "$extract_stream_output"
      ;;
    *)
      fatal 2 execution invalid-arguments operation extract
      ;;
  esac
  extract_status=$?
  if [ "$extract_status" -ne 0 ]
  then
    command -p -- rm -f -- "$extract_stream_output" 2>/dev/null
    fatal execution execution-failed operation extract reason decompression-failed format "$extract_format"
  fi
}

extract_zip()
{
  extract_require unzip
  UNZIP= UNZIPOPT= command -- unzip -qq -d "$extract_destination" "$extract_artifact" || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
}

extract_7z_command()
{
  for extract_candidate in 7zz 7z 7za
  do
    if extract_have "$extract_candidate"
    then
      printf -- '%s\n' "$extract_candidate"
      return 0
    fi
  done
  return 1
}

extract_7z()
{
  extract_command="$(extract_7z_command)" || fatal execution command-not-found operation extract command 7z format "$extract_format"
  command -- "$extract_command" x -y "-o$extract_destination" -- "$extract_artifact" >/dev/null || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
}

extract_dmg_cleanup()
{
  extract_cleanup_status=$?
  trap - 0 HUP INT TERM

  if [ "$extract_dmg_mounted" -eq 1 ]
  then
    if command -- hdiutil detach "$extract_dmg_mount" >/dev/null 2>&1
    then
      extract_dmg_mounted=0
    fi
  fi

  if [ "$extract_dmg_mounted" -eq 0 ] && [ -d "$extract_dmg_mount" ] && [ ! -L "$extract_dmg_mount" ]
  then
    command -p -- rmdir "$extract_dmg_mount" 2>/dev/null || :
  fi

  exit "$extract_cleanup_status"
}

extract_dmg_native()
{
  readpathce extract_dmg_artifact "$extract_artifact" || fatal execution execution-failed operation extract reason artifact-resolution-failed format "$extract_format"
  readpathce extract_dmg_destination "$extract_destination" || fatal execution execution-failed operation extract reason destination-resolution-failed format "$extract_format"

  extract_dmg_mount="$m_TMP_DIR/.extract-dmg-$$"
  [ ! -e "$extract_dmg_mount" ] && [ ! -L "$extract_dmg_mount" ] || fatal execution execution-failed operation extract reason temporary-target-exists format "$extract_format"
  command -p -- mkdir "$extract_dmg_mount" || fatal execution execution-failed operation extract reason temporary-create-failed format "$extract_format"

  extract_dmg_mounted=0
  trap extract_dmg_cleanup 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  command -- hdiutil attach -readonly -nobrowse -mountpoint "$extract_dmg_mount" "$extract_dmg_artifact" >/dev/null || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
  extract_dmg_mounted=1

  command -- ditto "$extract_dmg_mount" "$extract_dmg_destination" || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"

  command -- hdiutil detach "$extract_dmg_mount" >/dev/null || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
  extract_dmg_mounted=0

  command -p -- rmdir "$extract_dmg_mount" || fatal execution execution-failed operation extract reason temporary-cleanup-failed format "$extract_format"
  trap - 0 HUP INT TERM
}

extract_dmg()
{
  if extract_have hdiutil && extract_have ditto
  then
    extract_dmg_native
  else
    extract_7z
  fi
}

extract_deb()
{
  extract_require dpkg-deb
  command -- dpkg-deb -x "$extract_artifact" "$extract_destination" || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
}

[ "$#" -eq 3 ] || fatal 2 execution invalid-arguments operation extract
extract_format=$1
extract_artifact=$2
extract_destination=$3

[ -f "$extract_artifact" ] && [ -r "$extract_artifact" ] || fatal execution execution-failed operation extract reason artifact-invalid format "$extract_format"
[ -d "$extract_destination" ] && [ ! -L "$extract_destination" ] || fatal execution execution-failed operation extract reason destination-invalid format "$extract_format"

case "$extract_format" in
  tar)
    extract_tar_stream || fatal execution execution-failed operation extract reason extraction-failed format "$extract_format"
    ;;
  tar.gz|tgz)
    extract_compressed_tar gzip
    ;;
  tar.bz2|tar.bzip2|tbz|tbz2)
    extract_compressed_tar bzip2
    ;;
  tar.xz|txz)
    extract_compressed_tar xz
    ;;
  tar.zst|tzst)
    extract_compressed_tar zstd
    ;;
  gzip|gz)
    extract_stream gzip
    ;;
  bzip|bzip2|bz2)
    extract_stream bzip2
    ;;
  xz)
    extract_stream xz
    ;;
  zstd|zst)
    extract_stream zstd
    ;;
  zip|jar|war)
    extract_zip
    ;;
  7z|7zip)
    extract_7z
    ;;
  dmg)
    extract_dmg
    ;;
  deb)
    extract_deb
    ;;
  *)
    fatal 2 execution invalid-arguments operation extract
    ;;
esac

exit 0
