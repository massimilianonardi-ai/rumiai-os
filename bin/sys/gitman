  gitman_action_group "$1" 'Git actions'     sync_push 'Sync + Push: git add --all → git commit -m <commit-message> → git pull --no-rebase --no-edit → git push'     status 'Status: git status --short --branch'     diff 'Diff: git diff'     pull 'Pull: git pull'     commit 'Commit: git commit -m <commit-message>'     changes 'Changes >'     history 'History >'     branches 'Branches >'     remote 'Remote >'     stash 'Stash >'
