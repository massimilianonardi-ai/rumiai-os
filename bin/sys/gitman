for gitman_required_command in git menu pager read-key state-path
do
  command -v "$gitman_required_command" >/dev/null 2>&1 ||
    fatal 127 execution command-not-found operation gitman command "$gitman_required_command"
done

gitman_invocation_directory=$(
  CDPATH= cd -P -- . 2>/dev/null &&
    command -p pwd -P
) || fatal 1 execution execution-failed operation gitman reason working-directory-unavailable

gitman_conf_dir=$(command -- state-path user sys gitman conf) ||
  fatal 1 execution execution-failed operation gitman reason configuration-path-unavailable
gitman_conf_file="$gitman_conf_dir/repositories"

array gitman_repositories ||
  fatal 1 execution execution-failed operation gitman reason repository-storage-failed

gitman_last_error=
gitman_output_mode=pager
gitman_action_sequence_label=
gitman_action_sequence_header_printed=0

gitman_initial_candidates_load "$@" ||
  fatal 1 execution execution-failed operation gitman reason initial-candidate-load-failed

gitman_initial_validate ||
  fatal 1 execution execution-failed operation gitman reason initial-candidate-validation-failed

while :
do
  array gitman_repositories size gitman_repository_count ||
    fatal 1 execution execution-failed operation gitman reason repository-storage-failed

  if [ "$gitman_repository_count" -eq 0 ]
  then
    if ! gitman_filesystem_acquire 'Select Git repositories'
    then
      exit 0
    fi
    continue
  fi

  gitman_repository_menu
  gitman_repository_menu_status=$?

  case "$gitman_repository_menu_status" in
    0) ;;
    1) exit 0 ;;
    *)
      fatal 1 execution execution-failed operation gitman reason repository-menu-failed
      ;;
  esac

  case "$gitman_repository_menu_key" in
    enter)
      case "$gitman_repository_menu_index" in
        ""|*[!0123456789]*)
          gitman_menu_failure
          ;;
      esac
      array gitman_repositories get "$gitman_repository_menu_index" gitman_repository_value ||
        gitman_menu_failure
      gitman_repository_actions "$gitman_repository_value" ||
        fatal 1 execution execution-failed operation gitman reason action-menu-failed
      ;;
    a)
      gitman_filesystem_acquire 'Add Git repositories' || :
      ;;
    r)
      gitman_remove_menu ||
        fatal 1 execution execution-failed operation gitman reason remove-menu-failed
      ;;
    c)
      array gitman_repositories ||
        fatal 1 execution execution-failed operation gitman reason repository-storage-failed
      gitman_last_error=
      ;;
    s)
      gitman_config_save ||
        fatal 1 execution execution-failed operation gitman reason configuration-save-failed
      ;;
    e)
      gitman_config_edit ||
        fatal 1 execution execution-failed operation gitman reason configuration-edit-failed
      ;;
    *)
      gitman_menu_failure
      ;;
  esac
done
