#!/usr/bin/env m

loadsyslib "array"

gitman_display_safe()
{
  [ "$#" -eq 1 ] || return 2

  printf '%s' "$1" |
    command -p tr '\n' '?' |
    command -p awk '{ gsub(/[[:cntrl:]]/, "?"); printf "%s", $0 }'
}

gitman_config_decode()
{
  [ "$#" -eq 1 ] || return 2

  gitman_config_decoded=$(
    printf '%s' "$1" |
      command -p awk '
        BEGIN { ORS = "" }
        {
          for (i = 1; i <= length($0); i++) {
            ch = substr($0, i, 1)

            if (ch == "\\") {
              if (i < length($0)) {
                next_ch = substr($0, i + 1, 1)

                if (next_ch == "n") {
                  printf "\n"
                  i++
                  continue
                }

                if (next_ch == "\\") {
                  printf "\\"
                  i++
                  continue
                }
              }

              printf "\\"
              continue
            }

            printf "%s", ch
          }
        }
      '
    printf 'X'
  ) || return 1

  gitman_config_decoded=${gitman_config_decoded%X}
  return 0
}

gitman_config_encode()
{
  [ "$#" -eq 1 ] || return 2

  gitman_config_encoded=$(
    printf '%sX' "$1" |
      command -p awk '
        BEGIN { ORS = "" }
        {
          if (NR > 1) {
            printf "\\n"
          }

          for (i = 1; i <= length($0); i++) {
            ch = substr($0, i, 1)

            if (ch == "\\") {
              printf "\\\\"
            } else {
              printf "%s", ch
            }
          }
        }
      '
  ) || return 1

  gitman_config_encoded=${gitman_config_encoded%X}
  printf '%s\n' "$gitman_config_encoded"
}

gitman_error_batch_begin()
{
  gitman_batch_error=
}

gitman_error_batch_add()
{
  [ "$#" -eq 1 ] || return 2

  if [ -n "$gitman_batch_error" ]
  then
    gitman_batch_error="$gitman_batch_error; $1"
  else
    gitman_batch_error=$1
  fi
}

gitman_error_batch_end()
{
  gitman_last_error=$gitman_batch_error
}

gitman_repository_present()
{
  [ "$#" -eq 1 ] || return 2

  array gitman_repositories size gitman_repository_count || return 2
  gitman_repository_index=0

  while [ "$gitman_repository_index" -lt "$gitman_repository_count" ]
  do
    array gitman_repositories get "$gitman_repository_index" gitman_repository_value || return 2
    [ "$gitman_repository_value" != "$1" ] || return 0
    gitman_repository_index=$((gitman_repository_index + 1))
  done

  return 1
}

gitman_candidate_resolve()
{
  [ "$#" -eq 1 ] || return 2

  gitman_candidate_error=
  gitman_candidate_repository=
  gitman_candidate_display=$(gitman_display_safe "$1") || return 1

  if [ ! -d "$1" ]
  then
    gitman_candidate_error="not a directory: $gitman_candidate_display"
    return 1
  fi

  gitman_candidate_directory=$(
    CDPATH= cd -P -- "$1" 2>/dev/null &&
      command -p pwd -P
  ) || {
    gitman_candidate_error="cannot resolve directory: $gitman_candidate_display"
    return 1
  }

  gitman_candidate_bare=$(command -- git -C "$gitman_candidate_directory" rev-parse --is-bare-repository 2>/dev/null)
  gitman_candidate_git_status=$?

  if [ "$gitman_candidate_git_status" -ne 0 ]
  then
    gitman_candidate_error="not a Git working tree: $gitman_candidate_display"
    return 1
  fi

  if [ "$gitman_candidate_bare" = true ]
  then
    gitman_candidate_error="bare Git repository is not supported: $gitman_candidate_display"
    return 1
  fi

  gitman_candidate_inside=$(command -- git -C "$gitman_candidate_directory" rev-parse --is-inside-work-tree 2>/dev/null) || {
    gitman_candidate_error="not a Git working tree: $gitman_candidate_display"
    return 1
  }

  if [ "$gitman_candidate_inside" != true ]
  then
    gitman_candidate_error="not a Git working tree: $gitman_candidate_display"
    return 1
  fi

  gitman_candidate_top=$(command -- git -C "$gitman_candidate_directory" rev-parse --show-toplevel 2>/dev/null) || {
    gitman_candidate_error="cannot resolve Git working-tree top-level: $gitman_candidate_display"
    return 1
  }

  gitman_candidate_repository=$(
    CDPATH= cd -P -- "$gitman_candidate_top" 2>/dev/null &&
      command -p pwd -P
  ) || {
    gitman_candidate_error="cannot resolve Git working-tree top-level: $gitman_candidate_display"
    return 1
  }

  return 0
}

gitman_candidate_process()
{
  [ "$#" -eq 1 ] || return 2

  if gitman_candidate_resolve "$1"
  then
    gitman_repository_present "$gitman_candidate_repository"
    gitman_repository_present_status=$?

    case "$gitman_repository_present_status" in
      0) : ;;
      1)
        array gitman_repositories add "$gitman_candidate_repository" || return 1
        ;;
      *)
        return 1
        ;;
    esac
  else
    gitman_candidate_status=$?
    [ "$gitman_candidate_status" -eq 1 ] || return "$gitman_candidate_status"
    gitman_error_batch_add "$gitman_candidate_error" || return 1
  fi

  return 0
}

gitman_validate_batch()
{
  gitman_error_batch_begin

  for gitman_candidate in "$@"
  do
    gitman_candidate_process "$gitman_candidate" || return 1
  done

  gitman_error_batch_end
  return 0
}

gitman_config_read()
{
  array gitman_config_candidates || return 1
  gitman_config_error=

  if [ -e "$gitman_conf_file" ] || [ -L "$gitman_conf_file" ]
  then
    if [ -f "$gitman_conf_file" ] && [ -r "$gitman_conf_file" ]
    then
      while IFS= read -r gitman_config_encoded || [ -n "$gitman_config_encoded" ]
      do
        [ -n "$gitman_config_encoded" ] || continue
        gitman_config_decode "$gitman_config_encoded" || return 1
        array gitman_config_candidates add "$gitman_config_decoded" || return 1
      done < "$gitman_conf_file"
    else
      gitman_config_display=$(gitman_display_safe "$gitman_conf_file") || return 1
      gitman_config_error="cannot read configuration file: $gitman_config_display"
    fi
  fi

  return 0
}

gitman_initial_candidates_load()
{
  array gitman_initial_candidates || return 1
  gitman_initial_config_error=

  if [ "$#" -gt 0 ]
  then
    for gitman_initial_candidate in "$@"
    do
      array gitman_initial_candidates add "$gitman_initial_candidate" || return 1
    done
    return 0
  fi

  gitman_config_read || return 1
  gitman_initial_config_error=$gitman_config_error

  array gitman_config_candidates size gitman_config_candidate_count || return 1
  gitman_config_candidate_index=0

  while [ "$gitman_config_candidate_index" -lt "$gitman_config_candidate_count" ]
  do
    array gitman_config_candidates get "$gitman_config_candidate_index" gitman_config_candidate || return 1
    array gitman_initial_candidates add "$gitman_config_candidate" || return 1
    gitman_config_candidate_index=$((gitman_config_candidate_index + 1))
  done

  array gitman_initial_candidates size gitman_initial_candidate_count || return 1
  if [ "$gitman_initial_candidate_count" -eq 0 ]
  then
    array gitman_initial_candidates add "." || return 1
  fi

  return 0
}

gitman_initial_validate()
{
  gitman_error_batch_begin

  if [ -n "$gitman_initial_config_error" ]
  then
    gitman_error_batch_add "$gitman_initial_config_error" || return 1
  fi

  array gitman_initial_candidates size gitman_initial_candidate_count || return 1
  gitman_initial_candidate_index=0

  while [ "$gitman_initial_candidate_index" -lt "$gitman_initial_candidate_count" ]
  do
    array gitman_initial_candidates get "$gitman_initial_candidate_index" gitman_initial_candidate || return 1
    gitman_candidate_process "$gitman_initial_candidate" || return 1
    gitman_initial_candidate_index=$((gitman_initial_candidate_index + 1))
  done

  gitman_error_batch_end
  return 0
}

gitman_menu_failure()
{
  fatal 1 execution execution-failed operation gitman reason menu-failed
}

gitman_filesystem_acquire()
{
  gitman_acquire_header=$1

  gitman_acquire_result=$(
    command -- menu       -H "$gitman_acquire_header"       -F 'Enter: browse | Space: mark | Tab: add | Escape: back/exit'       -B "$gitman_last_error"       -M       -d "$gitman_invocation_directory"
  )
  gitman_acquire_status=$?

  case "$gitman_acquire_status" in
    0) ;;
    1) return 1 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_acquire_status" ;;
  esac

  eval "set -- $gitman_acquire_result" || gitman_menu_failure
  [ "$#" -ge 2 ] || gitman_menu_failure
  gitman_acquire_key=$1
  shift

  [ "$gitman_acquire_key" = tab ] || gitman_menu_failure

  gitman_validate_batch "$@" ||
    fatal 1 execution execution-failed operation gitman reason repository-validation-failed

  return 0
}

gitman_repository_menu()
{
  array gitman_repositories size gitman_repository_count || return 2
  [ "$gitman_repository_count" -gt 0 ] || return 2

  set --
  gitman_repository_index=0

  while [ "$gitman_repository_index" -lt "$gitman_repository_count" ]
  do
    array gitman_repositories get "$gitman_repository_index" gitman_repository_value || return 2
    gitman_repository_label=$(gitman_display_safe "$gitman_repository_value") || return 2
    set -- "$@" "$gitman_repository_index@:=$gitman_repository_label"
    gitman_repository_index=$((gitman_repository_index + 1))
  done

  gitman_repository_result=$(
    command -- menu       -H 'Git repositories'       -F 'Enter: open | a: add | r: remove | c: clear all | s: save | e: edit conf | Escape: exit'       -B "$gitman_last_error"       -K a -K r -K c -K s -K e       -- "$@"
  )
  gitman_repository_status=$?

  case "$gitman_repository_status" in
    0) ;;
    1) return 1 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_repository_status" ;;
  esac

  eval "set -- $gitman_repository_result" || gitman_menu_failure
  [ "$#" -eq 2 ] || gitman_menu_failure

  gitman_repository_menu_key=$1
  gitman_repository_menu_index=$2
  return 0
}

gitman_index_selected()
{
  [ "$#" -ge 2 ] || return 2
  gitman_index_target=$1
  shift

  for gitman_selected_index in "$@"
  do
    [ "$gitman_selected_index" != "$gitman_index_target" ] || return 0
  done

  return 1
}

gitman_repositories_remove()
{
  array gitman_repositories_new || return 1
  array gitman_repositories size gitman_repository_count || return 1
  gitman_repository_index=0

  while [ "$gitman_repository_index" -lt "$gitman_repository_count" ]
  do
    if ! gitman_index_selected "$gitman_repository_index" "$@"
    then
      array gitman_repositories get "$gitman_repository_index" gitman_repository_value || return 1
      array gitman_repositories_new add "$gitman_repository_value" || return 1
    fi
    gitman_repository_index=$((gitman_repository_index + 1))
  done

  array gitman_repositories || return 1
  array gitman_repositories_new size gitman_repository_count || return 1
  gitman_repository_index=0

  while [ "$gitman_repository_index" -lt "$gitman_repository_count" ]
  do
    array gitman_repositories_new get "$gitman_repository_index" gitman_repository_value || return 1
    array gitman_repositories add "$gitman_repository_value" || return 1
    gitman_repository_index=$((gitman_repository_index + 1))
  done

  gitman_last_error=
  return 0
}

gitman_remove_menu()
{
  array gitman_repositories size gitman_repository_count || return 2
  [ "$gitman_repository_count" -gt 0 ] || return 0

  set --
  gitman_repository_index=0

  while [ "$gitman_repository_index" -lt "$gitman_repository_count" ]
  do
    array gitman_repositories get "$gitman_repository_index" gitman_repository_value || return 2
    gitman_repository_label=$(gitman_display_safe "$gitman_repository_value") || return 2
    set -- "$@" "$gitman_repository_index@:=$gitman_repository_label"
    gitman_repository_index=$((gitman_repository_index + 1))
  done

  gitman_remove_result=$(
    command -- menu       -H 'Remove Git repositories'       -F 'Space: mark | Enter: remove | Backspace/Escape: repositories'       -B "$gitman_last_error"       -M -K backspace       -- "$@"
  )
  gitman_remove_status=$?

  case "$gitman_remove_status" in
    0) ;;
    1) return 0 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_remove_status" ;;
  esac

  eval "set -- $gitman_remove_result" || gitman_menu_failure
  [ "$#" -ge 2 ] || gitman_menu_failure

  gitman_remove_key=$1
  shift

  case "$gitman_remove_key" in
    backspace)
      return 0
      ;;
    enter)
      gitman_repositories_remove "$@" ||
        fatal 1 execution execution-failed operation gitman reason repository-remove-failed
      ;;
    *)
      gitman_menu_failure
      ;;
  esac

  return 0
}

gitman_config_overwrite_confirm()
{
  gitman_confirm_result=$(
    command -- menu       -H 'Overwrite repositories configuration?'       -F 'Enter: choose | Escape: cancel'       -B "$gitman_last_error"       --       'no@:=No'       'yes@:=Yes'
  )
  gitman_confirm_status=$?

  case "$gitman_confirm_status" in
    0) ;;
    1) return 1 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_confirm_status" ;;
  esac

  eval "set -- $gitman_confirm_result" || gitman_menu_failure
  [ "$#" -eq 2 ] || gitman_menu_failure
  [ "$1" = enter ] || gitman_menu_failure
  [ "$2" = yes ]
}

gitman_config_save()
{
  if [ -e "$gitman_conf_file" ] || [ -L "$gitman_conf_file" ]
  then
    if [ ! -f "$gitman_conf_file" ] || [ -L "$gitman_conf_file" ]
    then
      gitman_conf_display=$(gitman_display_safe "$gitman_conf_file") || return 1
      gitman_last_error="cannot save configuration: not a regular file: $gitman_conf_display"
      return 0
    fi

    if [ -s "$gitman_conf_file" ]
    then
      gitman_config_overwrite_confirm || return 0
    fi
  fi

  command -p -- mkdir -p -- "$gitman_conf_dir" 2>/dev/null || {
    gitman_conf_display=$(gitman_display_safe "$gitman_conf_dir") || return 1
    gitman_last_error="cannot save configuration: cannot create directory: $gitman_conf_display"
    return 0
  }

  [ -d "$gitman_conf_dir" ] || {
    gitman_conf_display=$(gitman_display_safe "$gitman_conf_dir") || return 1
    gitman_last_error="cannot save configuration: invalid directory: $gitman_conf_display"
    return 0
  }

  gitman_conf_tmp="$gitman_conf_dir/.repositories.tmp"
  command -p -- rm -f -- "$gitman_conf_tmp" 2>/dev/null || {
    gitman_last_error='cannot save configuration: temporary-file cleanup failed'
    return 0
  }

  (
    umask 077
    : > "$gitman_conf_tmp" || exit 1

    array gitman_repositories size gitman_save_count || exit 1
    gitman_save_index=0

    while [ "$gitman_save_index" -lt "$gitman_save_count" ]
    do
      array gitman_repositories get "$gitman_save_index" gitman_save_repository || exit 1
      gitman_config_encode "$gitman_save_repository" >> "$gitman_conf_tmp" || exit 1
      gitman_save_index=$((gitman_save_index + 1))
    done
  ) || {
    command -p -- rm -f -- "$gitman_conf_tmp" 2>/dev/null || :
    gitman_last_error='cannot save configuration: write failed'
    return 0
  }

  command -p -- mv -- "$gitman_conf_tmp" "$gitman_conf_file" 2>/dev/null || {
    command -p -- rm -f -- "$gitman_conf_tmp" 2>/dev/null || :
    gitman_last_error='cannot save configuration: replace failed'
    return 0
  }

  gitman_last_error=
  return 0
}

gitman_config_reload_confirm()
{
  gitman_reload_confirm_result=$(
    command -- menu       -H 'Reset repositories and reload configuration?'       -F 'Enter: choose | Escape: keep current repositories'       -B "$gitman_last_error"       --       'no@:=No'       'yes@:=Yes'
  )
  gitman_reload_confirm_status=$?

  case "$gitman_reload_confirm_status" in
    0) ;;
    1) return 1 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_reload_confirm_status" ;;
  esac

  eval "set -- $gitman_reload_confirm_result" || gitman_menu_failure
  [ "$#" -eq 2 ] || gitman_menu_failure
  [ "$1" = enter ] || gitman_menu_failure
  [ "$2" = yes ]
}

gitman_config_reload()
{
  gitman_config_read || return 1

  array gitman_repositories || return 1
  gitman_error_batch_begin

  if [ -n "$gitman_config_error" ]
  then
    gitman_error_batch_add "$gitman_config_error" || return 1
  fi

  array gitman_config_candidates size gitman_reload_count || return 1
  gitman_reload_index=0

  while [ "$gitman_reload_index" -lt "$gitman_reload_count" ]
  do
    array gitman_config_candidates get "$gitman_reload_index" gitman_reload_candidate || return 1
    gitman_candidate_process "$gitman_reload_candidate" || return 1
    gitman_reload_index=$((gitman_reload_index + 1))
  done

  gitman_error_batch_end
  return 0
}

gitman_config_edit()
{
  command -p mkdir -p -- "$gitman_conf_dir" 2>/dev/null || {
    gitman_conf_display=$(gitman_display_safe "$gitman_conf_dir") || return 1
    gitman_last_error="cannot edit configuration: cannot create directory: $gitman_conf_display"
    return 0
  }

  if [ -e "$gitman_conf_file" ] || [ -L "$gitman_conf_file" ]
  then
    if [ ! -f "$gitman_conf_file" ]
    then
      gitman_conf_display=$(gitman_display_safe "$gitman_conf_file") || return 1
      gitman_last_error="cannot edit configuration: not a regular file: $gitman_conf_display"
      return 0
    fi
  fi

  if [ -n "${VISUAL-}" ]
  then
    gitman_editor=$VISUAL
  elif [ -n "${EDITOR-}" ]
  then
    gitman_editor=$EDITOR
  else
    gitman_editor=vi
  fi

  command -v "$gitman_editor" >/dev/null 2>&1 || {
    gitman_editor_display=$(gitman_display_safe "$gitman_editor") || return 1
    gitman_last_error="cannot edit configuration: editor not found: $gitman_editor_display"
    return 0
  }

  command -- "$gitman_editor" "$gitman_conf_file"
  gitman_editor_status=$?

  if [ "$gitman_editor_status" -ne 0 ]
  then
    gitman_last_error="configuration editor exited with status $gitman_editor_status"
    return 0
  fi

  gitman_last_error=

  if gitman_config_reload_confirm
  then
    gitman_config_reload || return 1
  fi

  return 0
}

gitman_pause()
{
  printf '\nPress any key to continue...' > /dev/tty ||
    fatal 1 execution execution-failed operation gitman reason terminal-output-failed

  command -- read-key >/dev/null
  gitman_pause_status=$?

  printf '\n' > /dev/tty 2>/dev/null || :

  [ "$gitman_pause_status" -eq 0 ] ||
    fatal 1 execution execution-failed operation gitman reason key-read-failed
}

gitman_terminal_header()
{
  [ "$#" -eq 1 ] || return 2

  printf '\n%s\n%s\n%s\n' \
    '--------------------------------------------------' \
    "$1" \
    '--------------------------------------------------' ||
    fatal 1 execution execution-failed operation gitman reason terminal-output-failed
}

gitman_action_sequence_begin()
{
  [ "$#" -eq 0 ] || return 2

  if [ "$gitman_output_mode" = terminal ] &&
     [ "$gitman_action_sequence_header_printed" -eq 0 ]
  then
    gitman_terminal_header "$gitman_action_sequence_label" || return 2
    gitman_action_sequence_header_printed=1
  fi

  return 0
}

gitman_git_exec()
{
  [ "$#" -ge 3 ] || return 2
  gitman_git_exec_repository=$1
  gitman_git_exec_action=$2
  shift 2

  case "$gitman_output_mode" in
    pager)
      if [ -n "${LESS-}" ]
      then
        gitman_git_exec_less="$LESS -R -+F -+X"
      else
        gitman_git_exec_less='-R -+F -+X'
      fi

      LESS=$gitman_git_exec_less GIT_PAGER=pager \
        command -- git --paginate -C "$gitman_git_exec_repository" "$@"
      gitman_git_exec_status=$?
      ;;
    terminal)
      gitman_action_sequence_begin || return 2

      command -- git --no-pager -C "$gitman_git_exec_repository" "$@"
      gitman_git_exec_status=$?
      ;;
    *)
      return 2
      ;;
  esac

  if [ "$gitman_git_exec_status" -eq 0 ]
  then
    gitman_last_error=
  else
    gitman_last_error="git $gitman_git_exec_action failed with status $gitman_git_exec_status"
  fi

  return 0
}

gitman_git_run()
{
  gitman_git_exec "$@" || return $?

  if [ "$gitman_output_mode" = terminal ]
  then
    gitman_pause
  fi

  return 0
}

gitman_action_status()
{
  [ "$#" -eq 1 ] || return 2
  gitman_git_run "$1" status status --short --branch
}

gitman_action_diff()
{
  [ "$#" -eq 1 ] || return 2
  gitman_git_run "$1" diff diff
}

gitman_action_pull()
{
  [ "$#" -eq 1 ] || return 2
  gitman_git_run "$1" pull pull
}

gitman_commit_message_acquire()
{
  printf '\nCommit message: ' > /dev/tty ||
    fatal 1 execution execution-failed operation gitman reason terminal-output-failed

  if ! IFS= read -r gitman_commit_message < /dev/tty
  then
    gitman_last_error='cannot read commit message'
    return 1
  fi

  if [ -z "$gitman_commit_message" ]
  then
    gitman_last_error=
    return 1
  fi

  return 0
}

gitman_action_commit()
{
  [ "$#" -eq 1 ] || return 2

  gitman_commit_message_acquire || return 0
  gitman_git_run "$1" 'commit -m <commit-message>' commit -m "$gitman_commit_message"
}

gitman_action_sync_push()
{
  [ "$#" -eq 1 ] || return 2
  gitman_sync_repository=$1
  gitman_sync_continue=1

  gitman_action_sequence_begin || return 2

  gitman_sync_status=$(command -- git -C "$gitman_sync_repository" status --porcelain)
  gitman_sync_status_code=$?

  if [ "$gitman_sync_status_code" -ne 0 ]
  then
    gitman_last_error="git status --porcelain failed with status $gitman_sync_status_code"
    gitman_sync_continue=0
  elif [ -n "$gitman_sync_status" ]
  then
    if gitman_commit_message_acquire
    then
      gitman_git_exec "$gitman_sync_repository" 'add --all' add --all || return 2

      if [ "$gitman_git_exec_status" -eq 0 ]
      then
        gitman_git_exec "$gitman_sync_repository" 'commit -m <commit-message>' commit -m "$gitman_commit_message" || return 2
      fi

      [ "$gitman_git_exec_status" -eq 0 ] || gitman_sync_continue=0
    else
      gitman_sync_continue=0
    fi
  fi

  if [ "$gitman_sync_continue" -eq 1 ]
  then
    gitman_git_exec "$gitman_sync_repository" 'pull --no-rebase --no-edit' pull --no-rebase --no-edit || return 2
    [ "$gitman_git_exec_status" -eq 0 ] || gitman_sync_continue=0
  fi

  if [ "$gitman_sync_continue" -eq 1 ]
  then
    gitman_git_exec "$gitman_sync_repository" push push || return 2
  fi

  if [ "$gitman_output_mode" = terminal ]
  then
    gitman_pause
  fi

  return 0
}

gitman_action_diff_staged()
{
  [ "$#" -eq 1 ] || return 2
  gitman_git_run "$1" 'diff --staged' diff --staged
}

