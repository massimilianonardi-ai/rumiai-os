gitman_action_menu()
{
  [ "$#" -ge 4 ] || return 2
  gitman_action_menu_repository=$1
  gitman_action_menu_title=$2
  shift 2

  [ $(( $# % 2 )) -eq 0 ] || return 2

  array gitman_action_menu_items || return 2
  array gitman_action_menu_ids || return 2
  array gitman_action_menu_labels || return 2

  while [ "$#" -gt 0 ]
  do
    gitman_action_menu_id=$1
    gitman_action_menu_label=$2
    shift 2

    case "$gitman_action_menu_id" in
      ""|*[!abcdefghijklmnopqrstuvwxyz0123456789_]*)
        return 2
        ;;
    esac

    array gitman_action_menu_items add "$gitman_action_menu_id@:=$gitman_action_menu_label" || return 2
    array gitman_action_menu_ids add "$gitman_action_menu_id" || return 2
    array gitman_action_menu_labels add "$gitman_action_menu_label" || return 2
  done

  set --
  array gitman_action_menu_items size gitman_action_menu_count || return 2
  gitman_action_menu_index=0

  while [ "$gitman_action_menu_index" -lt "$gitman_action_menu_count" ]
  do
    array gitman_action_menu_items get "$gitman_action_menu_index" gitman_action_menu_item || return 2
    set -- "$@" "$gitman_action_menu_item"
    gitman_action_menu_index=$((gitman_action_menu_index + 1))
  done

  gitman_action_menu_repository_display=$(gitman_display_safe "$gitman_action_menu_repository") || return 2
  gitman_action_menu_header="[output: $gitman_output_mode] $gitman_action_menu_title | $gitman_action_menu_repository_display"

  gitman_action_menu_result=$(
    command -- menu       -H "$gitman_action_menu_header"       -F 'Enter: select | p: toggle output | Backspace/Escape: back'       -B "$gitman_last_error"       -K backspace -K p       -- "$@"
  )
  gitman_action_menu_status=$?

  case "$gitman_action_menu_status" in
    0) ;;
    1) return 1 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_action_menu_status" ;;
  esac

  eval "set -- $gitman_action_menu_result" || gitman_menu_failure
  [ "$#" -eq 2 ] || gitman_menu_failure

  gitman_action_menu_key=$1
  gitman_action_menu_value=$2
  gitman_action_menu_selected_label=

  if [ "$gitman_action_menu_key" = enter ]
  then
    gitman_action_menu_index=0

    while [ "$gitman_action_menu_index" -lt "$gitman_action_menu_count" ]
    do
      array gitman_action_menu_ids get "$gitman_action_menu_index" gitman_action_menu_id || return 2

      if [ "$gitman_action_menu_id" = "$gitman_action_menu_value" ]
      then
        array gitman_action_menu_labels get "$gitman_action_menu_index" gitman_action_menu_selected_label || return 2
        break
      fi

      gitman_action_menu_index=$((gitman_action_menu_index + 1))
    done

    [ -n "$gitman_action_menu_selected_label" ] || return 2
  fi

  return 0
}

gitman_action_dispatch()
{
  [ "$#" -eq 3 ] || return 2

  case "$2" in
    ""|*[!abcdefghijklmnopqrstuvwxyz0123456789_]*)
      return 2
      ;;
  esac

  gitman_action_sequence_label=$3
  gitman_action_sequence_header_printed=0
  gitman_action_handler="gitman_action_$2"
  "$gitman_action_handler" "$1"
}

gitman_action_group()
{
  [ "$#" -ge 4 ] || return 2

  while :
  do
    gitman_action_menu "$@"
    gitman_action_group_status=$?

    case "$gitman_action_group_status" in
      0) ;;
      1) return 0 ;;
      *) return "$gitman_action_group_status" ;;
    esac

    case "$gitman_action_menu_key" in
      backspace)
        return 0
        ;;
      p)
        case "$gitman_output_mode" in
          pager) gitman_output_mode=terminal ;;
          terminal) gitman_output_mode=pager ;;
          *) return 2 ;;
        esac
        gitman_last_error=
        ;;
      enter)
        gitman_action_dispatch "$1" "$gitman_action_menu_value" "$gitman_action_menu_selected_label" || return 2
        ;;
      *)
        return 2
        ;;
    esac
  done
}

gitman_action_switch()
{
  [ "$#" -eq 1 ] || return 2
  gitman_switch_repository=$1

  array gitman_switch_branches || return 2
  gitman_switch_refs=$(command -- git -C "$gitman_switch_repository" for-each-ref --format='%(refname:short)' refs/heads)
  gitman_switch_refs_status=$?

  if [ "$gitman_switch_refs_status" -ne 0 ]
  then
    gitman_last_error="git branch enumeration failed with status $gitman_switch_refs_status"
    return 0
  fi

  while IFS= read -r gitman_switch_branch
  do
    [ -n "$gitman_switch_branch" ] || continue
    array gitman_switch_branches add "$gitman_switch_branch" || return 2
  done <<EOF_GITMAN_SWITCH
$gitman_switch_refs
EOF_GITMAN_SWITCH

  array gitman_switch_branches size gitman_switch_count || return 2
  if [ "$gitman_switch_count" -eq 0 ]
  then
    gitman_last_error='no local branches available'
    return 0
  fi

  set --
  gitman_switch_index=0

  while [ "$gitman_switch_index" -lt "$gitman_switch_count" ]
  do
    array gitman_switch_branches get "$gitman_switch_index" gitman_switch_branch || return 2
    gitman_switch_branch_display=$(gitman_display_safe "$gitman_switch_branch") || return 2
    set -- "$@" "$gitman_switch_index@:=Switch: git switch $gitman_switch_branch_display"
    gitman_switch_index=$((gitman_switch_index + 1))
  done

  gitman_switch_repository_display=$(gitman_display_safe "$gitman_switch_repository") || return 2
  gitman_switch_result=$(
    command -- menu       -H "[output: $gitman_output_mode] Switch branch | $gitman_switch_repository_display"       -F 'Enter: switch | Backspace/Escape: branches'       -B "$gitman_last_error"       -K backspace       -- "$@"
  )
  gitman_switch_status=$?

  case "$gitman_switch_status" in
    0) ;;
    1) return 0 ;;
    2) gitman_menu_failure ;;
    *) exit "$gitman_switch_status" ;;
  esac

  eval "set -- $gitman_switch_result" || gitman_menu_failure
  [ "$#" -eq 2 ] || gitman_menu_failure

  gitman_switch_key=$1
  gitman_switch_index=$2

  case "$gitman_switch_key" in
    backspace)
      return 0
      ;;
    enter)
      case "$gitman_switch_index" in
        ""|*[!0123456789]*)
          return 2
          ;;
      esac
      array gitman_switch_branches get "$gitman_switch_index" gitman_switch_branch || return 2
      gitman_switch_branch_display=$(gitman_display_safe "$gitman_switch_branch") || return 2
      gitman_action_sequence_label="Switch: git switch $gitman_switch_branch_display"
      gitman_action_sequence_header_printed=0
      gitman_git_run "$gitman_switch_repository" 'switch <branch>' switch "$gitman_switch_branch"
      ;;
    *)
      return 2
      ;;
  esac
}

