#!/usr/bin/env m

main()
{
  [ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] ||
    fatal 1 jsc invalid-arguments expected 2 received "$#"

  jsc_engine="$m_LIB_DIR/sys/js/jsc.lib.js"
  [ -f "$jsc_engine" ] && [ ! -L "$jsc_engine" ] &&
    [ -r "$jsc_engine" ] && [ ! -x "$jsc_engine" ] ||
    fatal 2 jsc engine-unavailable path "$jsc_engine"

  log debug jsc engine-selected path "$jsc_engine"
  log trace jsc runtime-resolution-started runtime nodejs

  pkg default nodejs >/dev/null 2>&1 ||
    fatal 3 jsc managed-node-unavailable package nodejs

  jsc_node=$(command -v node) ||
    fatal 4 jsc node-command-unavailable command node

  [ -n "$jsc_node" ] ||
    fatal 4 jsc node-command-unavailable command node

  log debug jsc runtime-selected command "$jsc_node"
  log info jsc compilation-started manifest "$1" output "$2"

  # Node executes outside the m shell and reports specific compilation errors
  # itself; propagating its status avoids a redundant shell fatal message.
  node "$jsc_engine" "$@"
  jsc_status=$?
  log trace jsc compiler-exited status "$jsc_status"
  return "$jsc_status"
}

main "$@"
