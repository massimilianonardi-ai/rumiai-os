#!/usr/bin/env m

[ "$#" -le 2 ] && [ -n "$1" ] || fatal 1 jsc invalid-arguments

if [ "$#" -eq 2 ]
then
  [ -n "$2" ] || fatal 1 jsc invalid-output
fi

source_dir=${1%/*}
modules_file=${1##*/}

[ "$source_dir" != "$1" ] || source_dir=.

if [ "$#" -eq 1 ]; then
  node "$m_ROOT/lib/sys/js/jsc.lib.js" "$1" || fatal 2 jsc compilation-failed
else
  output="$2"

  node "$m_ROOT/lib/sys/js/jsc.lib.js" "$1" > "$output" || fatal 2 jsc compilation-failed

  case $output in
    *.js)
      minified=${output%.js}.min.js
      minifier=google-closure-compiler
    ;;
    *.css)
      minified=${output%.css}.min.css
      minifier=uglifycss
    ;;
    *)
      minified=
      minifier=
    ;;
  esac

  artifact=$output

  if [ -n "$minifier" ]
  then
    if command -v "$minifier" >/dev/null 2>&1
    then
      case $minifier in
        google-closure-compiler)
          "$minifier" --js="$output" --js_output_file="$minified" ||
            fatal 4 jsc minification-failed
        ;;
        uglifycss)
          "$minifier" "$output" > "$minified" ||
            fatal 4 jsc minification-failed
        ;;
      esac

      artifact=$minified
    else
      log warning jsc minifier-unavailable command "$minifier"
    fi
  fi
  gzip -c < "$artifact" > "${artifact}.gz" || fatal 5 jsc compression-failed
fi
