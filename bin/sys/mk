#!/usr/bin/env m

[ "$#" -ge 1 ] || fatal 2 error execution invalid-arguments operation mk

mk_command=$1
shift

case "$mk_command" in
  materialize)
    [ "$#" -eq 3 ] || fatal 2 error execution invalid-arguments operation mk subcommand materialize
    . "$m_LIB_DIR/sys/sh/mk/mk-materialize.lib.sh"
    mk_materialize "$@"
    exit $?
    ;;
  *)
    fatal 2 error execution invalid-arguments operation mk subcommand "$mk_command"
    ;;
esac
