#!/usr/bin/env m

main()
{
  mk_engine="$m_LIB_DIR/sys/js/mk.lib.js"
  [ -f "$mk_engine" ] && [ ! -L "$mk_engine" ] && [ -r "$mk_engine" ] && [ ! -x "$mk_engine" ] ||
    fatal 1 error execution execution-failed operation mk reason javascript-engine-unavailable path "$mk_engine"

  pkg default nodejs >/dev/null 2>&1 ||
    fatal 1 error execution execution-failed operation mk reason nodejs-runtime-unavailable

  command -v node >/dev/null 2>&1 ||
    fatal 1 error execution execution-failed operation mk reason node-command-unavailable

  m_MK_CALLER_PATH=$PATH
  if [ "${HOME+x}" = x ]
  then
    m_MK_CALLER_HOME_DEFINED=1
    m_MK_CALLER_HOME=$HOME
  else
    m_MK_CALLER_HOME_DEFINED=0
    m_MK_CALLER_HOME=
  fi
  export m_MK_CALLER_PATH m_MK_CALLER_HOME_DEFINED m_MK_CALLER_HOME

  exec node -e 'const mk=require(process.argv[1]); Promise.resolve(mk.mkMain(process.argv.slice(2))).then(status => { process.exitCode=status; }, error => { process.stderr.write(`mk: ${error && error.message ? error.message : "unexpected failure"}\n`); process.exitCode=1; });' -- "$mk_engine" "$@"
}

main "$@"
