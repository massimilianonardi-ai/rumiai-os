#!/usr/bin/env m

[ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation pager

pager_source=$1
readpathce pager_file "$pager_source" || \
  fatal 1 execution execution-failed operation pager reason file-resolution-failed path "$pager_source"

[ -f "$pager_file" ] && [ -r "$pager_file" ] || \
  fatal 1 execution execution-failed operation pager reason file-unavailable path "$pager_source"

if ! [ -t 1 ]
then
  command -p cat "$pager_file" || \
    fatal 1 execution execution-failed operation pager reason output-failed path "$pager_source"
  exit 0
fi

. "$m_LIB_DIR/sys/sh/osarch.lib.sh"

case "$m_OSARCH_OS" in
  linux)
    if command -v -- less >/dev/null 2>&1
    then
      LESS= LESSOPEN= LESSCLOSE= command -- less "$pager_file" || \
        fatal 1 execution execution-failed operation pager reason backend-failed backend less path "$pager_source"
    else
      command -p more "$pager_file" || \
        fatal 1 execution execution-failed operation pager reason backend-failed backend more path "$pager_source"
    fi
    ;;
  *)
    command -p more "$pager_file" || \
      fatal 1 execution execution-failed operation pager reason backend-failed backend more path "$pager_source"
    ;;
esac

exit 0
