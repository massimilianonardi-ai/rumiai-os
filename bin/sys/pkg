#!/usr/bin/env rumiai-os

. "$m_LIB_DIR/sh/osarch.lib.sh"

[ "$#" -ge 1 ] || {
  log error execution invalid-arguments operation pkg
  exit 2
}

pkg_command=$1
shift

case "$pkg_command" in
  install)
    [ "$#" -ge 1 ] || {
      log error execution invalid-arguments operation pkg subcommand install
      exit 2
    }
    . "$m_LIB_DIR/sh/pkg-install.lib.sh"
    pkg_install "$@"
    exit $?
    ;;
  uninstall)
    [ "$#" -ge 1 ] || {
      log error execution invalid-arguments operation pkg subcommand uninstall
      exit 2
    }
    . "$m_LIB_DIR/sh/pkg-uninstall.lib.sh"
    pkg_uninstall "$@"
    exit $?
    ;;
  *)
    log error execution invalid-arguments operation pkg subcommand "$pkg_command"
    exit 2
    ;;
esac
