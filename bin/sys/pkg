#!/usr/bin/env m

. "$m_LIB_DIR/sys/sh/osarch.lib.sh"

[ "$#" -ge 1 ] || fatal execution invalid-arguments operation pkg

pkg_command=$1
shift

case "$pkg_command" in
  install|uninstall|versions|default) :;;
  *) fatal 2 execution invalid-arguments operation pkg subcommand "$pkg_command";;
esac

. "$m_LIB_DIR/sys/sh/pkg-${pkg_command}.lib.sh"

"pkg_${pkg_command}" "$@"
