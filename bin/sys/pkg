#!/usr/bin/env m

loadsyslib "osarch"

[ "$#" -ge 1 ] || fatal execution invalid-arguments operation pkg

pkg_command=$1
shift

case "$pkg_command" in
  install|uninstall|versions|default|provider|requirement) :;;
  *) fatal 2 execution invalid-arguments operation pkg subcommand "$pkg_command";;
esac

loadsyslib "pkg/pkg-${pkg_command}"

"pkg_${pkg_command}" "$@"
