#!/bin/sh

tty=/dev/tty
tty_state=
tty_changed=0

#------------------------------------------------------------------------------

tty_restore()
{
  [ "$tty_changed" -eq 1 ] || return 0

  (
    IFS='
'
    set -f
    set -- $tty_state
    command -p stty "$@" 2>/dev/null < "$tty"
  ) || return 1

  tty_changed=0
}

#------------------------------------------------------------------------------

cleanup()
{
  status=$?

  trap - 0 HUP INT QUIT TERM PIPE ABRT TSTP

  if ! tty_restore
  then
    [ "$status" -ne 0 ] || status=1
  fi

  exit "$status"
}

#------------------------------------------------------------------------------

main()
{
  [ "$#" -le 1 ] || return 2

  prompt=${1-}

  tty_state=$(command -p stty -g 2>/dev/null < "$tty") || return 1
  [ -n "$tty_state" ] || return 1

  trap cleanup 0
  trap 'exit 1' HUP INT QUIT TERM PIPE ABRT TSTP

  if [ -n "$prompt" ]
  then
    printf '%s' "$prompt" 2>/dev/null > "$tty" || return 1
  fi

  # From this point cleanup must attempt restoration even if stty itself fails.
  tty_changed=1
  command -p stty -echo 2>/dev/null < "$tty" || return 1

  IFS= read -r password < "$tty"
  read_status=$?

  # Restore before doing anything with the captured secret.
  tty_restore || return 1

  printf '\n' 2>/dev/null > "$tty" || return 1

  [ "$read_status" -eq 0 ] || return 1

  printf '%s\n' "$password"
}

#------------------------------------------------------------------------------

main "$@"
