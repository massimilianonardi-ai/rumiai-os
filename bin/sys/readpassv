#!/usr/bin/env m

main()
{
  [ "$#" -ge 2 ] && [ "$#" -le 3 ] || return 2

  prompt=$1
  verify_prompt=$2
  mismatch_message=${3-}
  readpass_command=$m_BIN_SYS_DIR/readpass

  [ -x "$readpass_command" ] || return 1

  password=$("$readpass_command" "$prompt")
  status=$?

  if [ "$status" -ne 0 ]
  then
    unset password
    return "$status"
  fi

  password_verify=$("$readpass_command" "$verify_prompt")
  status=$?

  if [ "$status" -ne 0 ]
  then
    unset password password_verify
    return "$status"
  fi

  if [ "$password" != "$password_verify" ]
  then
    unset password password_verify

    if [ -n "$mismatch_message" ]
    then
      printf '%s\n' "$mismatch_message" 2>/dev/null > /dev/tty || return 1
    fi

    return 3
  fi

  printf '%s\n' "$password"
  status=$?

  unset password password_verify

  return "$status"
}

#------------------------------------------------------------------------------

main "$@"
