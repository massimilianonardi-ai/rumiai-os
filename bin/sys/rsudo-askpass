#!/usr/bin/env m

log debug "rsudo-askpass called! ...checking if caller is ssh! RSUDO_PASSWORD $([ -n "$RSUDO_PASSWORD" ] && printf '%s\n' "is exported and not null" || printf '%s\n' "is NOT exported (null)")"
if [ "$(ps -o "comm=" -p "$PPID")" = "ssh" ]
then
  if [ -t 0 ]
  then
    if [ -n "$RSUDO_FIFO" ]
    then
      # delete redundant to ensure removal even on some interruption
      trap "rm -f '$RSUDO_FIFO'" INT QUIT TERM HUP PIPE ABRT TSTP EXIT
      exec 0<"$RSUDO_FIFO"
      read -r RSUDO_PASSWORD
      # delete redundant with main process to ensure removal even on some interruption
      rm -f "$RSUDO_FIFO"
      RSUDO_PASSWORD="$(printf '%s\n' "$RSUDO_PASSWORD" | openssl enc -d -A -base64 | RSUDO_TOKEN="$RSUDO_TOKEN" openssl enc -d -aes-256-cbc -pbkdf2 -pass "env:RSUDO_TOKEN")"
    else
      log_fatal "wrong rsudo-askpass method"
      exit 1
    fi
  else
    read -r RSUDO_PASSWORD
  fi

  printf '%s\n' "$RSUDO_PASSWORD"

  log debug "rsudo askpass called by ssh! RSUDO_PASSWORD read and $([ -n "$RSUDO_PASSWORD" ] && printf '%s\n' "is not null" || printf '%s\n' "is null")"
  # log trace "RSUDO_PASSWORD=$RSUDO_PASSWORD"

  [ -z "$RSUDO_PASSWORD" ] && fatal "password is null!"
else
  fatal "security checkfailed!"
fi
