#!/usr/bin/env m

. "$m_LIB_DIR/sys/sh/pkg/pkg-provider.lib.sh"
. "$m_LIB_DIR/sys/sh/pkg/facility/pkg-facility.lib.sh"

srv_name_valid()
{
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    "" | [!abcdefghijklmnopqrstuvwxyz0123456789]* | *[!abcdefghijklmnopqrstuvwxyz0123456789._-]* | *[._-]) return 1 ;;
  esac
}

srv_pid_valid()
{
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    "" | *[!0123456789]*) return 1 ;;
    0) return 1 ;;
  esac
}

srv_pid_exists()
{
  [ "$#" -eq 1 ] || return 2
  srv_ps_pid="$(command -p -- ps -p "$1" -o pid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')"
  [ "$srv_ps_pid" = "$1" ]
}

srv_caller_pid_get()
{
  srv_caller_pid="$(command -p -- ps -p "$$" -o ppid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')"
  srv_pid_valid "$srv_caller_pid"
}

srv_paths_prepare()
{
  srv_run_root="$(command -- state-path user sys srv run)" || return 1
  srv_log_root="$(command -- state-path user sys srv log)" || return 1

  umask 077
  command -p -- mkdir -p -- "$srv_run_root" "$srv_log_root" || return 1

  [ -d "$srv_run_root" ] && [ ! -L "$srv_run_root" ] || return 1
  [ -d "$srv_log_root" ] && [ ! -L "$srv_log_root" ] || return 1

  srv_runtime_dir="$srv_run_root/$srv_name"
  srv_log_file="$srv_log_root/$srv_name.log"
}

srv_lock_release()
{
  if [ -n "${srv_lock_file-}" ]
  then
    srv_lock_current_pid=
    if [ -f "$srv_lock_file" ] && [ ! -L "$srv_lock_file" ]
    then
      srv_lock_current_pid="$(command -p -- cat "$srv_lock_file" 2>/dev/null)"
    fi

    if [ "$srv_lock_current_pid" = "$$" ]
    then
      command -p -- rm -f -- "$srv_lock_file" 2>/dev/null
    fi
    srv_lock_file=
  fi

  if [ -n "${srv_lock_owner_file-}" ]
  then
    command -p -- rm -f -- "$srv_lock_owner_file" 2>/dev/null
    srv_lock_owner_file=
  fi

  if [ -n "${srv_unpublished_pid-}" ]
  then
    kill "$srv_unpublished_pid" 2>/dev/null
    srv_unpublished_pid=
  fi
}

srv_lock_acquire()
{
  srv_lock_file="$srv_run_root/.$srv_name.lock"
  srv_lock_owner_file="$srv_run_root/.$srv_name.lock.$$"
  srv_lock_wait=0

  command -p -- rm -f -- "$srv_lock_owner_file" 2>/dev/null
  printf -- '%s\n' "$$" > "$srv_lock_owner_file" || \
    fatal 1 execution execution-failed operation srv reason lock-owner-create-failed service "$srv_name"

  while ! command -p -- ln "$srv_lock_owner_file" "$srv_lock_file" 2>/dev/null
  do
    srv_lock_pid=
    if [ -f "$srv_lock_file" ] && [ ! -L "$srv_lock_file" ]
    then
      srv_lock_pid="$(command -p -- cat "$srv_lock_file" 2>/dev/null)"
    fi

    if srv_pid_valid "$srv_lock_pid" && srv_pid_exists "$srv_lock_pid"
    then
      [ "$srv_lock_wait" -lt 10 ] || \
        fatal 1 execution execution-failed operation srv reason busy service "$srv_name"
      command -p -- sleep 1
      srv_lock_wait=$((srv_lock_wait + 1))
      continue
    fi

    command -p -- rm -f -- "$srv_lock_file" 2>/dev/null || \
      fatal 1 execution execution-failed operation srv reason lock-cleanup-failed service "$srv_name"
  done

  command -p -- rm -f -- "$srv_lock_owner_file" 2>/dev/null
  srv_lock_owner_file=

  trap 'srv_lock_release' 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

srv_runtime_remove()
{
  if [ -e "$srv_runtime_dir" ] || [ -L "$srv_runtime_dir" ]
  then
    command -p -- rm -rf -- "$srv_runtime_dir" || return 1
  fi
}

srv_runtime_pid_read()
{
  srv_pid=

  [ -d "$srv_runtime_dir" ] && [ ! -L "$srv_runtime_dir" ] || return 1
  [ -f "$srv_runtime_dir/pid" ] && [ ! -L "$srv_runtime_dir/pid" ] && [ -r "$srv_runtime_dir/pid" ] || return 1

  srv_pid="$(command -p -- cat "$srv_runtime_dir/pid" 2>/dev/null)" || return 1
  srv_pid_valid "$srv_pid"
}

srv_runtime_read()
{
  srv_owner=
  srv_command=
  srv_provider=

  srv_runtime_pid_read || return 1

  for srv_metadata_file in owner command
  do
    [ -f "$srv_runtime_dir/$srv_metadata_file" ] && \
    [ ! -L "$srv_runtime_dir/$srv_metadata_file" ] && \
    [ -r "$srv_runtime_dir/$srv_metadata_file" ] || return 1
  done

  srv_owner="$(command -p -- cat "$srv_runtime_dir/owner" 2>/dev/null)" || return 1
  srv_command="$(command -p -- cat "$srv_runtime_dir/command" 2>/dev/null)" || return 1

  srv_pid_valid "$srv_owner" || return 1
  [ -n "$srv_command" ] || return 1

  if [ -e "$srv_runtime_dir/provider" ] || [ -L "$srv_runtime_dir/provider" ]
  then
    [ -f "$srv_runtime_dir/provider" ] && \
    [ ! -L "$srv_runtime_dir/provider" ] && \
    [ -r "$srv_runtime_dir/provider" ] || return 1
    srv_provider="$(command -p -- cat "$srv_runtime_dir/provider" 2>/dev/null)" || return 1
    case "$srv_provider" in
      "" | */* | *'
'*) return 1 ;;
    esac
  fi
}

srv_runtime_publish()
{
  srv_runtime_tmp="$srv_run_root/.$srv_name.runtime.$$"
  command -p -- rm -rf -- "$srv_runtime_tmp" 2>/dev/null
  command -p -- mkdir -- "$srv_runtime_tmp" || return 1

  {
    printf -- '%s\n' "$srv_pid" > "$srv_runtime_tmp/pid" && \
    printf -- '%s\n' "$srv_caller_pid" > "$srv_runtime_tmp/owner" && \
    printf -- '%s\n' "$srv_command" > "$srv_runtime_tmp/command" && \
    { [ -z "$srv_provider" ] || printf -- '%s\n' "$srv_provider" > "$srv_runtime_tmp/provider"; }
  } || {
    command -p -- rm -rf -- "$srv_runtime_tmp" 2>/dev/null
    return 1
  }

  command -p -- mv -- "$srv_runtime_tmp" "$srv_runtime_dir" || {
    command -p -- rm -rf -- "$srv_runtime_tmp" 2>/dev/null
    return 1
  }
}

srv_start()
{
  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv subcommand start
  srv_name=$1
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv subcommand start service "$srv_name"
  srv_caller_pid_get || fatal 1 execution execution-failed operation srv reason caller-pid-unavailable service "$srv_name"
  srv_paths_prepare || fatal 1 execution execution-failed operation srv reason state-unavailable service "$srv_name"
  srv_lock_acquire

  if [ -e "$srv_runtime_dir" ] || [ -L "$srv_runtime_dir" ]
  then
    if srv_runtime_read && srv_pid_exists "$srv_pid"
    then
      printf -- 'srv: %s already running pid=%s\n' "$srv_name" "$srv_pid"
      return 0
    fi

    if srv_runtime_pid_read && srv_pid_exists "$srv_pid"
    then
      fatal 1 execution execution-failed operation srv reason live-runtime-state-invalid service "$srv_name" pid "$srv_pid"
    fi

    srv_runtime_remove || fatal 1 execution execution-failed operation srv reason stale-state-cleanup-failed service "$srv_name"
  fi

  srv_provider=
  srv_provider_backed=0
  srv_provider="$(pkg_provider_default_resolve "$srv_name" 2>/dev/null)"
  srv_provider_status=$?

  case "$srv_provider_status" in
    0)
      srv_command="$(pkg_facility_service_start_resolve "$srv_name" "$srv_provider")" || \
        fatal 1 execution execution-failed operation srv reason service-realization-invalid service "$srv_name" provider "$srv_provider"
      srv_provider_backed=1
      ;;
    1 | 2)
      srv_provider=
      srv_command_name="$srv_name-start"
      readpathce srv_command "$srv_command_name" || \
        fatal 127 execution command-not-found operation srv command "$srv_command_name"
      [ -f "$srv_command" ] && [ -x "$srv_command" ] || \
        fatal 126 execution execution-failed operation srv reason command-not-executable command "$srv_command"
      ;;
    *)
      fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
      ;;
  esac

  if [ "$srv_provider_backed" -eq 1 ]
  then
    command -p -- nohup "$m_BOOTSTRAP_BIN" "$srv_command" >> "$srv_log_file" 2>&1 </dev/null &
  else
    command -p -- nohup "$srv_command" >> "$srv_log_file" 2>&1 </dev/null &
  fi
  srv_pid=$!
  srv_unpublished_pid=$srv_pid

  command -p -- sleep 1
  srv_pid_exists "$srv_pid" || {
    srv_unpublished_pid=
    fatal 1 execution execution-failed operation srv reason exited-during-start service "$srv_name" log "$srv_log_file"
  }

  srv_runtime_publish || fatal 1 execution execution-failed operation srv reason state-publish-failed service "$srv_name"
  srv_unpublished_pid=

  printf -- 'srv: %s started pid=%s\n' "$srv_name" "$srv_pid"
}

srv_stop()
{
  srv_force=0
  if [ "${1-}" = -f ]
  then
    srv_force=1
    shift
  fi

  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv subcommand stop
  srv_name=$1
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv subcommand stop service "$srv_name"
  srv_caller_pid_get || fatal 1 execution execution-failed operation srv reason caller-pid-unavailable service "$srv_name"
  srv_paths_prepare || fatal 1 execution execution-failed operation srv reason state-unavailable service "$srv_name"
  srv_lock_acquire

  if [ ! -e "$srv_runtime_dir" ] && [ ! -L "$srv_runtime_dir" ]
  then
    printf -- 'srv: %s not running\n' "$srv_name"
    return 0
  fi

  if ! srv_runtime_read
  then
    if srv_runtime_pid_read && srv_pid_exists "$srv_pid"
    then
      fatal 1 execution execution-failed operation srv reason live-runtime-state-invalid service "$srv_name" pid "$srv_pid"
    fi

    srv_runtime_remove || fatal 1 execution execution-failed operation srv reason stale-state-cleanup-failed service "$srv_name"
    printf -- 'srv: %s not running; stale state removed\n' "$srv_name"
    return 0
  fi

  if ! srv_pid_exists "$srv_pid"
  then
    srv_runtime_remove || fatal 1 execution execution-failed operation srv reason stale-state-cleanup-failed service "$srv_name"
    printf -- 'srv: %s not running; stale state removed\n' "$srv_name"
    return 0
  fi

  if [ "$srv_force" -ne 1 ] && [ "$srv_owner" != "$srv_caller_pid" ]
  then
    printf -- 'srv: %s pid=%s was not started by this caller; leaving it running\n' "$srv_name" "$srv_pid"
    printf -- 'srv: use srv stop -f %s to stop it explicitly\n' "$srv_name"
    return 0
  fi

  if ! kill "$srv_pid" 2>/dev/null
  then
    if srv_pid_exists "$srv_pid"
    then
      fatal 1 execution execution-failed operation srv reason signal-failed service "$srv_name" pid "$srv_pid"
    fi
  fi

  srv_wait=0
  while srv_pid_exists "$srv_pid" && [ "$srv_wait" -lt 10 ]
  do
    command -p -- sleep 1
    srv_wait=$((srv_wait + 1))
  done

  if srv_pid_exists "$srv_pid"
  then
    fatal 1 execution execution-failed operation srv reason stop-timeout service "$srv_name" pid "$srv_pid"
  fi

  srv_runtime_remove || fatal 1 execution execution-failed operation srv reason state-cleanup-failed service "$srv_name"
  printf -- 'srv: %s stopped\n' "$srv_name"
}

srv_host_provider_resolve()
{
  [ "$#" -eq 1 ] || return 2
  srv_name=$1

  srv_provider="$(pkg_provider_default_resolve "$srv_name" 2>/dev/null)" || return 1
  srv_command="$(pkg_facility_service_start_resolve "$srv_name" "$srv_provider")" || return 1
}

srv_host_user_run()
{
  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv
  srv_name=$1
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv service "$srv_name"

  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  exec "$m_BOOTSTRAP_BIN" "$srv_command"
  fatal 1 execution execution-failed operation srv reason provider-exec-failed service "$srv_name"
}

srv_host_account_prepare()
{
  srv_host_uid="$(command -p -- id -u 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"
  case "$srv_host_uid" in
    "" | *[!0123456789]*) fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" ;;
  esac

  srv_host_user_name="$(command -p -- id -un 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"
  case "$srv_host_user_name" in
    "" | */* | *'
'*) fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" ;;
  esac
}

srv_host_home_validate()
{
  case "$srv_host_home" in
    /*) : ;;
    *) fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name" ;;
  esac
  [ -d "$srv_host_home" ] ||
    fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name"
}

srv_host_systemd_arg_write()
{
  [ "$#" -eq 1 ] || return 2

  printf '"'
  LC_ALL=C printf '%s' "$1" |
    command -p -- od -A n -t x1 |
    command -p -- awk '{
      for (i = 1; i <= NF; i++)
        printf "\\x%s", $i
    }' || return 1
  printf '"'
}

srv_host_systemd_call()
{
  [ "$#" -ge 1 ] || return 2

  HOME="$srv_host_home" \
  XDG_CONFIG_HOME="$srv_host_home/.config" \
  XDG_RUNTIME_DIR="$srv_host_runtime" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=$srv_host_runtime/bus" \
    "$srv_systemctl" --user "$@"
}

srv_host_systemd_prepare()
{
  srv_systemctl="$(command -p -v systemctl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"
  srv_getent="$(command -p -v getent 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"

  srv_host_account_prepare
  srv_host_home="$(
    "$srv_getent" passwd "$srv_host_uid" 2>/dev/null |
      command -p -- awk -F: -v uid="$srv_host_uid" '$3 == uid { print $6; exit }'
  )" || fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name"
  srv_host_home_validate

  srv_host_runtime="/run/user/$srv_host_uid"
  [ -d "$srv_host_runtime" ] ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"
  srv_host_systemd_call show-environment >/dev/null 2>&1 ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"

  srv_host_unit="m-srv-$srv_name.service"
  srv_host_dir="$srv_host_home/.config/systemd/user"
  srv_host_manifest="$srv_host_dir/$srv_host_unit"
}

srv_host_systemd_install()
{
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  command -p -- mkdir -p -- "$srv_host_dir" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  [ -d "$srv_host_dir" ] && [ ! -L "$srv_host_dir" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
  fi

  srv_host_tmp="$srv_host_manifest.tmp.$"
  command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
  umask 077
  (
    printf '%s\n' '[Unit]'
    printf 'Description=RumiAI user service %s\n' "$srv_name"
    printf '%s\n' ''
    printf '%s\n' '[Service]'
    printf '%s\n' 'Type=simple'
    printf '%s' 'ExecStart=/bin/sh '
    srv_host_systemd_arg_write "$m_BOOTSTRAP_BIN" || exit 1
    printf ' '
    srv_host_systemd_arg_write "$m_COMMAND_BIN" || exit 1
    printf ' '
    srv_host_systemd_arg_write '--host-user-run' || exit 1
    printf ' '
    srv_host_systemd_arg_write "$srv_name" || exit 1
    printf '\n\n'
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=default.target'
  ) > "$srv_host_tmp" || {
    command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  }

  command -p -- chmod 600 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  command -p -- mv -- "$srv_host_tmp" "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  srv_host_systemd_call daemon-reload ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  if ! srv_host_systemd_call enable "$srv_host_unit"
  then
    command -p -- rm -f -- "$srv_host_manifest" 2>/dev/null
    srv_host_systemd_call daemon-reload >/dev/null 2>&1 || :
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
}

srv_host_systemd_manifest_require()
{
  [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
}

srv_host_systemd_start()
{
  srv_host_systemd_manifest_require
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  srv_host_systemd_call start "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
}

srv_host_systemd_stop()
{
  srv_host_systemd_manifest_require
  srv_host_systemd_call stop "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
}

srv_host_systemd_restart()
{
  srv_host_systemd_manifest_require
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  srv_host_systemd_call restart "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
}

srv_host_systemd_uninstall()
{
  if [ ! -e "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ]
  then
    return 0
  fi
  srv_host_systemd_manifest_require

  srv_host_systemd_call stop "$srv_host_unit" >/dev/null 2>&1 || :
  srv_host_systemd_call disable "$srv_host_unit" >/dev/null 2>&1 || :
  command -p -- rm -f -- "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-remove-failed service "$srv_name"
  srv_host_systemd_call daemon-reload ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action uninstall service "$srv_name"
}

srv_host_launchd_prepare()
{
  srv_launchctl="$(command -p -v launchctl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"
  srv_plutil="$(command -p -v plutil 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"
  srv_dscl="$(command -p -v dscl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"

  srv_host_account_prepare
  srv_host_domain="gui/$srv_host_uid"
  "$srv_launchctl" print "$srv_host_domain" >/dev/null 2>&1 ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"

  srv_host_home="$(
    "$srv_dscl" . -read "/Users/$srv_host_user_name" NFSHomeDirectory 2>/dev/null |
      command -p -- sed -n 's/^NFSHomeDirectory: //p' |
      command -p -- sed -n '1p'
  )" || fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name"
  srv_host_home_validate

  srv_host_label="m.srv.$srv_name"
  srv_host_dir="$srv_host_home/Library/LaunchAgents"
  srv_host_manifest="$srv_host_dir/$srv_host_label.plist"
  srv_host_target="$srv_host_domain/$srv_host_label"
}

srv_host_launchd_install()
{
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  command -p -- mkdir -p -- "$srv_host_dir" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  [ -d "$srv_host_dir" ] && [ ! -L "$srv_host_dir" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
  fi

  srv_host_tmp="$srv_host_manifest.tmp.$"
  command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
  "$srv_plutil" -create xml1 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  "$srv_plutil" -insert Label -string "$srv_host_label" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments -array "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.0 -string "$m_BOOTSTRAP_BIN" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.1 -string "$m_COMMAND_BIN" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.2 -string '--host-user-run' "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.3 -string "$srv_name" "$srv_host_tmp" &&
  "$srv_plutil" -insert RunAtLoad -bool true "$srv_host_tmp" ||
    {
      command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
      fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
    }

  command -p -- chmod 600 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  command -p -- mv -- "$srv_host_tmp" "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if ! "$srv_launchctl" enable "$srv_host_target"
  then
    command -p -- rm -f -- "$srv_host_manifest" 2>/dev/null
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
}

srv_host_launchd_manifest_require()
{
  [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
}

srv_host_launchd_loaded()
{
  "$srv_launchctl" print "$srv_host_target" >/dev/null 2>&1
}

srv_host_launchd_wait_unloaded()
{
  srv_host_wait=0
  while srv_host_launchd_loaded && [ "$srv_host_wait" -lt 10 ]
  do
    command -p -- sleep 1
    srv_host_wait=$((srv_host_wait + 1))
  done
  ! srv_host_launchd_loaded
}

srv_host_launchd_start()
{
  srv_host_launchd_manifest_require
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" kickstart "$srv_host_target" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
  else
    "$srv_launchctl" bootstrap "$srv_host_domain" "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
  fi
}

srv_host_launchd_stop()
{
  srv_host_launchd_manifest_require
  srv_host_launchd_loaded || return 0

  "$srv_launchctl" bootout "$srv_host_target" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
  srv_host_launchd_wait_unloaded ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
}

srv_host_launchd_restart()
{
  srv_host_launchd_manifest_require
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" kickstart -k "$srv_host_target" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
  else
    "$srv_launchctl" bootstrap "$srv_host_domain" "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
  fi
}

srv_host_launchd_uninstall()
{
  if [ ! -e "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ]
  then
    "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :
    return 0
  fi
  srv_host_launchd_manifest_require

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" bootout "$srv_host_target" >/dev/null 2>&1 || :
    srv_host_launchd_wait_unloaded ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action uninstall service "$srv_name"
  fi

  command -p -- rm -f -- "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-remove-failed service "$srv_name"
  "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :
}

srv_host_user()
{
  [ "$#" -eq 2 ] || fatal 2 execution invalid-arguments operation srv subcommand host
  srv_host_action=$1
  srv_name=$2
  srv_name_valid "$srv_name" ||
    fatal 2 execution invalid-arguments operation srv subcommand host service "$srv_name"

  srv_host_os="$(command -p -- uname -s 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-platform-unavailable service "$srv_name"

  case "$srv_host_os" in
    Linux)
      srv_host_systemd_prepare
      case "$srv_host_action" in
        install) srv_host_systemd_install ;;
        uninstall) srv_host_systemd_uninstall ;;
        start) srv_host_systemd_start ;;
        stop) srv_host_systemd_stop ;;
        restart) srv_host_systemd_restart ;;
        *) fatal 2 execution invalid-arguments operation srv subcommand host action "$srv_host_action" ;;
      esac
      ;;
    Darwin)
      srv_host_launchd_prepare
      case "$srv_host_action" in
        install) srv_host_launchd_install ;;
        uninstall) srv_host_launchd_uninstall ;;
        start) srv_host_launchd_start ;;
        stop) srv_host_launchd_stop ;;
        restart) srv_host_launchd_restart ;;
        *) fatal 2 execution invalid-arguments operation srv subcommand host action "$srv_host_action" ;;
      esac
      ;;
    *)
      fatal 1 execution execution-failed operation srv reason unsupported-host host "$srv_host_os" service "$srv_name"
      ;;
  esac
}

srv_host()
{
  [ "$#" -ge 1 ] || fatal 2 execution invalid-arguments operation srv subcommand host
  srv_host_scope=$1
  shift

  case "$srv_host_scope" in
    user) srv_host_user "$@" ;;
    *) fatal 2 execution invalid-arguments operation srv subcommand host scope "$srv_host_scope" ;;
  esac
}

[ "$#" -ge 1 ] || fatal 2 execution invalid-arguments operation srv

srv_subcommand=$1
shift

case "$srv_subcommand" in
  start)
    srv_start "$@"
    ;;
  stop)
    srv_stop "$@"
    ;;
  host)
    srv_host "$@"
    ;;
  --host-user-run)
    srv_host_user_run "$@"
    ;;
  *)
    fatal 2 execution invalid-arguments operation srv subcommand "$srv_subcommand"
    ;;
esac
