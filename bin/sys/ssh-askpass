#!/usr/bin/env m

loadsyslib "ipc"

set +x

[ "$#" -eq 1 ] || exit 2
[ "${SSH_ASKPASS_PROMPT-}" != "confirm" ] || exit 1

if [ -n "${m_SSH_ASKPASS_FIFO-}" ]
then
  [ -z "${m_SSH_ASKPASS_ID-}" ] || exit 1
  [ -p "$m_SSH_ASKPASS_FIFO" ] && [ ! -L "$m_SSH_ASKPASS_FIFO" ] || exit 1
  IFS= read -r _ssh_askpass_secret < "$m_SSH_ASKPASS_FIFO" || exit 1
  printf '%s\n' "$_ssh_askpass_secret"
  unset _ssh_askpass_secret
  exit 0
fi

[ -n "${m_SSH_ASKPASS_ID-}" ] || exit 1

ipc_once_get "$m_SSH_ASKPASS_ID" || exit 1

printf '\n'
