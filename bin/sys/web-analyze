#!/usr/bin/env node
'use strict';

// Bounded, passive reconnaissance. Raw evidence is intentionally private.
const fs = require('node:fs');
const path = require('node:path');

const LIMIT = {steps: 28, controls: 1200, html: 2_000_000, text: 200_000,
  quietMs: 1500, pendingQuietMs: 4500, initialSettleMs: 15000,
  scrollSettleMs: 6000, analysisMs: 45000};
const wait = ms => new Promise(resolve => setTimeout(resolve, ms));

function failure(status, identity, message)
{
  const error = new Error(message);
  error.status = status;
  error.identity = identity;
  return error;
}

function save(file, data)
{
  fs.writeFileSync(file, Buffer.isBuffer(data) || typeof data === 'string' ? data : JSON.stringify(data, null, 2) + '\n',
    {flag: 'wx', mode: 0o600});
}

function runDirectory(root)
{
  fs.mkdirSync(root, {recursive: true, mode: 0o700});
  for (let attempt = 0; attempt < 100; attempt++)
  {
    const leaf = `run-${new Date().toISOString().replace(/[:.]/g, '-')}-${process.pid}-${attempt}`;
    const directory = path.join(root, leaf);
    try
    {
      fs.mkdirSync(directory, {mode: 0o700});
      return directory;
    }
    catch (error)
    {
      if (error.code !== 'EEXIST') throw error;
    }
  }
  throw failure(5, 'run-directory-exhausted', 'cannot allocate a unique evidence directory');
}

const observeExpression = String.raw`(() => {
  const clean = (value, max = 180) => String(value || '').replace(/\s+/g, ' ').trim().slice(0, max);
  const identify = element => {
    const segments = [];
    for (let node = element; node && node.nodeType === 1 && segments.length < 7; node = node.parentElement) {
      let part = node.localName;
      if (node.id) { part += '#' + CSS.escape(node.id); segments.unshift(part); break; }
      let nth = 1;
      for (let sibling = node.previousElementSibling; sibling; sibling = sibling.previousElementSibling)
        if (sibling.localName === node.localName) nth++;
      segments.unshift(part + ':nth-of-type(' + nth + ')');
    }
    return segments.join(' > ');
  };
  const controls = Array.from(document.querySelectorAll(
    'a,button,input,select,textarea,summary,[role="button"],[role="link"],[role="tab"],[contenteditable="true"],[tabindex]'))
    .slice(0, ${LIMIT.controls}).map(node => ({
      selector: identify(node), tag: node.localName, type: node.getAttribute('type'),
      role: node.getAttribute('role'), label: clean(node.getAttribute('aria-label') ||
        node.labels?.[0]?.innerText || node.getAttribute('title') || node.innerText),
      href: node.getAttribute('href'), action: node.getAttribute('formaction'),
      disabled: !!node.disabled, hidden: node.getClientRects().length === 0,
      expanded: node.getAttribute('aria-expanded'), checked: node.checked === undefined ? null : !!node.checked,
      inlineHandlers: node.getAttributeNames().filter(name => /^on[a-z]+$/.test(name))
    }));
  const forms = Array.from(document.forms).slice(0, 100).map(form => ({
    selector: identify(form), action: form.action, method: form.method,
    inputs: Array.from(form.elements).slice(0, 100).map(node => ({
      tag: node.localName, name: node.getAttribute('name'), type: node.getAttribute('type'),
      required: !!node.required
    }))
  }));
  const frameworks = {nextData: !!document.getElementById('__NEXT_DATA__'),
    reactDomMarkers: 0, reactComponentNames: []};
  const names = new Set();
  for (const node of Array.from(document.querySelectorAll('*')).slice(0, 3000)) {
    const marker = Object.keys(node).find(key => /^__react(?:Fiber|Container)\$/.test(key));
    if (!marker) continue;
    frameworks.reactDomMarkers++;
    let fiber = node[marker];
    for (let depth = 0; fiber && depth < 12; fiber = fiber.return, depth++) {
      const type = fiber.type;
      const name = type && (type.displayName || type.name);
      if (typeof name === 'string' && name.length < 100) names.add(name);
      if (names.size >= 100) break;
    }
  }
  frameworks.reactComponentNames = Array.from(names).sort();
  return {url: location.href, title: document.title, readyState: document.readyState,
    capturedAt: new Date().toISOString(),
    headings: Array.from(document.querySelectorAll('h1,h2,h3,[role="heading"]')).slice(0, 200)
      .map(node => ({level: node.getAttribute('aria-level') || node.localName, text: clean(node.innerText)})),
    controls, forms, frameworks, html: document.documentElement?.outerHTML.slice(0, ${LIMIT.html}) || '',
    text: document.body?.innerText.slice(0, ${LIMIT.text}) || '',
    documentHeight: document.scrollingElement?.scrollHeight || 0,
    viewportHeight: window.innerHeight,
    truncated: {html: (document.documentElement?.outerHTML.length || 0) > ${LIMIT.html},
      text: (document.body?.innerText.length || 0) > ${LIMIT.text},
      controls: document.querySelectorAll('a,button,input,select,textarea,summary,[role="button"],[role="link"],[role="tab"],[contenteditable="true"],[tabindex]').length > ${LIMIT.controls}}
  };
})()`;

const scrollExpression = String.raw`(() => {
  const root = document.scrollingElement;
  const elements = [root, ...Array.from(document.querySelectorAll('*')).filter(node => {
    if (node === root || node.clientHeight < 70 || node.scrollHeight - node.clientHeight < 25) return false;
    return /^(auto|scroll|overlay)$/.test(getComputedStyle(node).overflowY);
  })];
  const candidates = elements.filter(Boolean).map(node => ({node,
    remaining: node.scrollHeight - node.clientHeight - node.scrollTop,
    height: node.clientHeight})).filter(item => item.remaining > 4)
    .sort((a, b) => b.remaining - a.remaining || b.height - a.height);
  for (const candidate of candidates.slice(0, 10)) {
    const before = candidate.node.scrollTop;
    candidate.node.scrollTop = Math.min(candidate.node.scrollHeight - candidate.node.clientHeight,
      before + Math.max(300, Math.floor(candidate.height * 0.85)));
    if (candidate.node.scrollTop > before + 1) {
      return {moved: true, container: candidate.node === root ? 'document' :
        candidate.node.localName + (candidate.node.id ? '#' + candidate.node.id : ''),
        from: Math.round(before), to: Math.round(candidate.node.scrollTop),
        total: candidate.node.scrollHeight};
    }
  }
  return {moved: false, candidates: candidates.length};
})()`;

// The observer watches the rendered DOM without changing the application's
// fetch/XHR interfaces. Each navigation receives a new document tracker.
const restExpression = String.raw`(() => {
  let tracker = globalThis.__mWebAnalyzeDomQuiet;
  if (!tracker || tracker.document !== document) {
    tracker = {document, lastMutationAt:performance.now(), mutations:0,
      observed:new WeakSet(), rootsObserved:0};
    tracker.observer = new MutationObserver(records => {
      tracker.lastMutationAt = performance.now();
      tracker.mutations += records.length;
    });
    Object.defineProperty(globalThis, '__mWebAnalyzeDomQuiet',
      {value:tracker, writable:true, configurable:true});
  }
  let scanned = 0;
  let truncated = false;
  let opaqueFrames = 0;
  const scan = root => {
    if (!root || scanned >= 50000) {truncated = true; return;}
    if (!tracker.observed.has(root)) {
      tracker.observer.observe(root,
        {subtree:true, childList:true, attributes:true, characterData:true});
      tracker.observed.add(root);
      tracker.rootsObserved++;
    }
    for (const node of root.querySelectorAll('*')) {
      if (++scanned >= 50000) {truncated = true; break;}
      if (node.shadowRoot) scan(node.shadowRoot);
      if (node.localName === 'iframe' || node.localName === 'frame') {
        try {
          if (node.contentDocument?.documentElement)
            scan(node.contentDocument.documentElement);
          else opaqueFrames++;
        } catch (_) {opaqueFrames++;}
      }
    }
  };
  scan(document.documentElement);
  return {url:location.href, readyState:document.readyState,
    domQuietMs:Math.max(0,Math.round(performance.now()-tracker.lastMutationAt)),
    mutationCount:tracker.mutations, rootsObserved:tracker.rootsObserved,
    rootScanTruncated:truncated, opaqueFrames,
    fontsLoaded:!document.fonts || document.fonts.status === 'loaded'};
})()`;

async function waitForRest(session, durationMs, warnings, interrupted)
{
  const start = Date.now();
  const deadline = start + durationMs;
  let observation = null;
  while (!interrupted())
  {
    try
    {
      const dom = await evaluate(session, restExpression);
      const network = session.networkActivity();
      observation = {...dom, ...network};
      if (dom.readyState === 'complete' && dom.fontsLoaded &&
          dom.domQuietMs >= LIMIT.quietMs && network.quietForMs >= LIMIT.quietMs)
      {
        if (network.inFlightRequests === 0 && network.pendingReads === 0)
          return {...observation, status: 'settled', waitedMs: Date.now() - start};
        // SSE, WebSockets and detached targets can leave requests open.
        // Save the DOM after extended quiet, but retain the unresolved status.
        if (network.quietForMs >= LIMIT.pendingQuietMs)
          return {...observation, status: 'dom-quiet-network-pending',
            waitedMs: Date.now() - start};
      }
    }
    catch (error)
    {
      warnings.push(`DOM settlement observation unavailable: ${error.message}`);
      return {...observation, status: 'unavailable', waitedMs: Date.now() - start};
    }
    if (Date.now() >= deadline) break;
    await wait(200);
  }
  return {...observation, status: interrupted() ? 'interrupted' : 'timeout',
    waitedMs: Date.now() - start};
}

async function saveRestDom(session, directory, stage, state, warnings)
{
  try
  {
    // Full rendered outerHTML, independent of the limited exploratory JSON.
    const html = await evaluate(session, 'document.documentElement?.outerHTML || ""');
    const filename = `dom-rest-${stage}.html`;
    save(path.join(directory, filename), html);
    save(path.join(directory, `dom-rest-${stage}.json`),
      {state: state.step, capturedAt: new Date().toISOString(), url: state.url,
        settlement: state.settlement, htmlBytes: Buffer.byteLength(html, 'utf8')});
  }
  catch (error)
  {
    warnings.push(`resting DOM ${stage}: ${error.message}`);
  }
}

async function evaluate(session, expression)
{
  const response = await session.sendPage('Runtime.evaluate',
    {expression, returnByValue: true, awaitPromise: true});
  if (response.exceptionDetails)
    throw new Error('browser evaluation failed: ' + response.exceptionDetails.text);
  if (!response.result || !Object.hasOwn(response.result, 'value'))
    throw new Error('browser evaluation returned no value');
  return response.result.value;
}

async function screenshot(session, directory, index, warnings)
{
  try
  {
    const image = await session.sendPage('Page.captureScreenshot', {format: 'png', captureBeyondViewport: false});
    if (!image.data) throw new Error('missing screenshot data');
    const file = `screen-${String(index).padStart(3, '0')}.png`;
    save(path.join(directory, file), Buffer.from(image.data, 'base64'));
    return file;
  }
  catch (error)
  {
    warnings.push(`screenshot ${index}: ${error.message}`);
    return null;
  }
}

async function explore(session, directory, warnings, interrupted, captureRestEvidence, scrollEnabled)
{
  const states = [];
  const statesDir = path.join(directory, 'states');
  fs.mkdirSync(statesDir, {mode: 0o700});
  for (let attempt = 0; attempt < 40 && !interrupted(); attempt++)
  {
    try
    {
      const ready = await evaluate(session, 'document.readyState !== "loading" && location.href !== "about:blank" && !!document.body');
      if (ready) break;
    }
    catch (error) {if (attempt === 39) warnings.push(`navigation: ${error.message}`);}
    await wait(500);
  }
  let lastScroll = null;
  let idle = 0;
  let analysisDeadline = Date.now() + LIMIT.analysisMs;
  for (let step = 0; step <= LIMIT.steps && !interrupted(); step++)
  {
    const remainingMs = analysisDeadline - Date.now();
    if (remainingMs <= 0)
    {
      warnings.push('exploration time budget exhausted before the next DOM state');
      break;
    }
    const settlement = await waitForRest(session,
      Math.min(remainingMs, step === 0 ? LIMIT.initialSettleMs : LIMIT.scrollSettleMs),
      warnings, interrupted);
    if (interrupted()) break;
    process.stderr.write(`web-analyze: state=${step} settlement=${settlement.status} ` +
      `domQuietMs=${settlement.domQuietMs ?? '-'} networkQuietMs=${settlement.quietForMs ?? '-'} ` +
      `inFlight=${settlement.inFlightRequests ?? '-'} pendingReads=${settlement.pendingReads ?? '-'}\n`);
    let state;
    try {state = await evaluate(session, observeExpression);}
    catch (error) {warnings.push(`DOM snapshot ${step}: ${error.message}`); break;}
    state.step = step;
    state.trigger = lastScroll || {kind: 'initial-navigation'};
    state.settlement = settlement;
    if (step === 0 || step % 5 === 0)
      state.screenshot = await screenshot(session, statesDir, step, warnings);
    save(path.join(statesDir, `state-${String(step).padStart(3, '0')}.json`), state);
    states.push(state);
    if (step === 0)
    {
      await saveRestDom(session, statesDir, 'initial', state, warnings);
      try
      {
        const result = await captureRestEvidence(session, directory, {interrupted});
        process.stderr.write('web-analyze: resting-page evidence=' + result.status +
          ' artifacts=' + result.artifacts.length + '\n');
        if (result.status !== 'captured')
          warnings.push('resting-page evidence incomplete; inspect rest/manifest.json');
      }
      catch (error)
      {
        warnings.push('resting-page evidence unavailable: ' + error.message);
      }
      // Deep passive inspection has its own lifecycle and must not consume
      // the optional post-rest scroll exploration time budget.
      analysisDeadline = Date.now() + LIMIT.analysisMs;
    }
    if (step === LIMIT.steps || (step === 0 && !scrollEnabled)) break;
    let scroll;
    try {scroll = await evaluate(session, scrollExpression);}
    catch (error) {warnings.push(`scroll ${step}: ${error.message}`); break;}
    if (!scroll.moved)
    {
      idle++;
      if (idle >= 3) break;
      await wait(350);
      continue;
    }
    idle = 0;
    lastScroll = {kind: 'scroll', ...scroll};
  }
  if (states.length)
    await saveRestDom(session, statesDir, 'final', states[states.length - 1], warnings);
  return states;
}

function readJsonl(file)
{
  if (!fs.existsSync(file)) return [];
  return fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).map(line => JSON.parse(line));
}

function displayOrigin(value)
{
  try
  {
    const url = new URL(value);
    if (!['http:', 'https:'].includes(url.protocol)) return '[non-http resource]';
    return url.origin;
  }
  catch (_) {return '[inline or opaque resource]';}
}
function displayMethod(value)
{
  const method = String(value || '').toUpperCase();
  return ['GET','POST','PUT','PATCH','DELETE','HEAD','OPTIONS']
    .includes(method) ? method : 'OTHER';
}
function markdown(value)
{
  return String(value ?? '').replace(/\s+/g, ' ').replace(/[|`]/g, '\\$&').slice(0, 250);
}

function table(rows, headers)
{
  return '| ' + headers.join(' | ') + ' |\n| ' + headers.map(() => '---').join(' | ') +
    ' |\n' + rows.map(row => '| ' + row.map(markdown).join(' | ') + ' |').join('\n') + '\n';
}

function documentReports(directory, url, states, summary, warnings, interrupted, scrollEnabled,
  integrity)
{
  const resources = readJsonl(path.join(directory, 'resources.jsonl'));
  const scripts = readJsonl(path.join(directory, 'scripts.jsonl'));
  const requests = resources.filter(row => row.url);
  const saved = resources.filter(row => row.status === 'saved');
  const controls = new Map();
  const components = new Set();
  const pages = new Set();
  for (const state of states)
  {
    pages.add(state.url);
    for (const name of state.frameworks.reactComponentNames) components.add(name);
    for (const control of state.controls)
    {
      const key = [control.selector, control.tag, control.label, control.href].join('\0');
      const existing = controls.get(key);
      if (existing) existing.last = state.step;
      else controls.set(key, {...control, first: state.step, last: state.step});
    }
  }
  const knownControls = [...controls.values()];
  const first = states[0];
  let capabilities = null;
  try
  {
    capabilities = JSON.parse(fs.readFileSync(
      path.join(directory, 'cdp-capabilities.json'), 'utf8'));
  }
  catch (_) { /* The report must not misrepresent missing CDP capabilities. */ }
  let rest = null;
  try
  {
    rest = JSON.parse(fs.readFileSync(path.join(directory,'rest/manifest.json'),'utf8'));
  }
  catch (_) { /* Missing rest evidence is explicitly reported below. */ }
  const overview = [
    '# Web analysis — observed evidence', '',
    `- Requested origin: ${displayOrigin(url)} (full URL retained in private evidence)`,
    `- Initial document origin: ${first ? displayOrigin(first.url) : '(not observed)'}`,
    '- Document title and page text: private; inspect the captured DOM evidence locally.',
    `- Observed DOM states: ${states.length}; distinct controls: ${knownControls.length}`,
    `- Automated scroll: ${scrollEnabled ? 'explicitly enabled' : 'not performed'}`,
    `- Initial DOM settlement: ${first?.settlement?.status || 'not observed'}`,
    '- [Deep resting-page evidence](rest/README.md) and [manifest](rest/manifest.json)',
    '- [Discovered targets and contexts](rest/target-graph-final.json), with [initial target graph](rest/target-graph-initial.json)',
    '- [Document observer status](rest/dom-history-contexts.json) and [pre-scroll mutation history](rest/dom-mutations-at-rest.jsonl)',
    `- Rest evidence: ${rest?.status || 'unavailable'}; artifacts: ${rest?.artifacts?.length ?? 0}`,
    `- Post-capture integrity: ${integrity?.status || 'unavailable'}; verified files: ${integrity?.counts?.verifiedFiles ?? 0}; discrepancies: ${integrity?.counts?.discrepancies ?? 0}`,
    '- [Evidence integrity and per-domain outcomes](evidence-integrity.json)',
    '- [Initial resting DOM](states/dom-rest-initial.html) and [final resting DOM](states/dom-rest-final.html)',
    '  (each has a matching JSON file with settlement evidence; verify status before assuming completeness).',
    `- CDP requests: ${summary.resourceCapture?.requests ?? 0}; bodies saved: ${summary.resourceCapture?.saved ?? 0}`,
    `- Response bytes archived: ${summary.resourceCapture?.bytes ?? 0}; partial streams: ${summary.resourceCapture?.partialStreams ?? 0}`,
    `- Compiled scripts archived: ${summary.resourceCapture?.scriptsSaved ?? 0}`,
    `- Browser CDP schema: ${capabilities?.protocol?.status || 'unavailable'}; domains: ${capabilities?.protocol?.domains?.length ?? 0}`,
    `- CDP packet ledger: ${summary.resourceCapture?.wireCapture?.status || 'unavailable'}; packets: ${summary.resourceCapture?.wireCapture?.packets ?? 0}`,
    `- Private DOM mutation ledger: ${summary.resourceCapture?.domHistory?.status || 'unavailable'}; records: ${summary.resourceCapture?.domHistory?.records ?? 0}; events: ${summary.resourceCapture?.domHistory?.events ?? 0}`,
    `- Interrupted: ${interrupted}; logged-event drops: ${JSON.stringify(summary.dropped)}`,
    '', '## Documents', '',
    '- [DOM and interfaces](DOM.md)', '- [Network and archived resources](NETWORK.md)',
    '- [JavaScript and React evidence](SCRIPTS.md)', '- [Observed flows](FLOWS.md)',
    '- [Coverage and limitations](LIMITATIONS.md)',
    '- [Browser CDP capabilities](cdp-capabilities.json) and [version-specific protocol](cdp-protocol.json) (when available)',
    '', '## Raw evidence', '',
    '`resources.jsonl` and `resources/` preserve decoded HTTP response bodies; `scripts.jsonl` and',
    '`scripts/` preserve compiled JavaScript sources; `states/` contains rendered DOM snapshots and screenshots.',
    '`cdp-wire.jsonl` preserves all CDP packets observed by the connected debugger, including otherwise unhandled events.',
    '`dom-mutations.jsonl` preserves private node-level mutation evidence including short-lived nodes and Shadow DOM roots;', 
    'its unredacted contents must never be copied to privacy-redacted dom.jsonl.',
    'The ledger is not evidence for disabled domains, unavailable targets, or events predating attachment.',
    'Other JSONL files record browser lifecycle, network, interaction, DOM mutation, console, performance and errors.',
    '', '**Sensitive:** Treat the entire directory, including the Chromium `profile/`, as private.',
    'Raw bodies, HTML, query strings and browser state may contain authentication data. Do not publish or commit it.', ''
  ];
  save(path.join(directory, 'README.md'), overview.join('\n') + '\n');

  const dom = ['# Observed DOM and interface', '',
    'This is an inventory of rendered states, not proof that every possible route or interaction was exercised.',
    '', '## DOM settlement before each observation', '',
    `A settled state requires readyState=complete, loaded fonts, ${LIMIT.quietMs} ms without`,
    'observed DOM mutations or network events, no pending body reads and no in-flight HTTP requests.',
    'A timeout/unavailable status means the DOM was preserved without a completion claim.', '',
    table(states.map(state => [state.step, state.settlement?.status,
      state.settlement?.readyState, state.settlement?.domQuietMs,
      state.settlement?.quietForMs, state.settlement?.inFlightRequests,
      state.settlement?.waitedMs]),
    ['State', 'Settlement', 'readyState', 'DOM quiet ms', 'Network quiet ms',
      'In-flight requests', 'Wait ms']),
    '', 'Full initial and final rendered HTML and their metadata are in',
    '`states/dom-rest-{initial,final}.{html,json}`.',
    '', '## Pages', '',
    table([...pages].map(page => [displayOrigin(page)]), ['Observed origin']),
    '## Headings (first observed state)', '',
    table((first?.headings || []).map(h => [h.level, '[private]', String(h.text || '').length]),
    ['Level', 'Text', 'Length']),
    '## Interactive elements (up to first 500 distinct)', '',
    table(knownControls.slice(0, 500).map(c => [c.tag, '[private]', '[private]',
      '[private]', c.first, c.last]),
    ['Element', 'Role/type', 'Label', 'Target/action', 'First state', 'Last state']),
    `Total distinct inventoried elements: ${knownControls.length}.`, '',
    '## Forms (first observed state)', '',
    table((first?.forms || []).map(f =>
      ['[private]', displayMethod(f.method), '[private]', f.inputs.length]),
    ['Selector', 'Method', 'Action', 'Input count']), ''
  ];
  save(path.join(directory, 'DOM.md'), dom.join('\n') + '\n');

  const kinds = new Map();
  for (const item of resources)
    kinds.set(item.resourceType || 'Unknown', (kinds.get(item.resourceType || 'Unknown') || 0) + 1);
  const sources = new Map();
  for (const resource of resources)
  {
    const source = resource.source || resource.status || 'unknown';
    sources.set(source, (sources.get(source) || 0) + 1);
  }
  const networkConfig = summary.resourceCapture?.networkConfiguration || [];
  const network = ['# Network and resource archive', '',
    'The browser/CDP observer saves responses it can retrieve; failures, redirects and active streams are explicit.',
    'Raw resource URLs and signed parameters are retained in private JSONL evidence.', '',
    '## CDP response retention configuration', '',
    'Durable messages and stream capture depend on the running browser version;',
    'an unsupported or failed capability never implies that all bodies are preserved.',
    table(networkConfig.map(row =>
      [row.targetId, row.enabled, row.durable, row.bufferErrorCode || '',
        row.durableErrorCode || '']),
    ['Target', 'Network.enable', 'Durable messages', 'Buffer error', 'Durable error']),
    '## Body sources and unresolved outcomes', '',
    table([...sources], ['Source or outcome', 'Count']),
    `Streaming partial-body artifacts: ${summary.resourceCapture?.partialStreams ?? 0}.`,
    'Requests that redirect, abort or remain open can have no complete body.',
    'A .partial artifact is not a complete HTTP response.', '',
    '## Resource types', '', table([...kinds], ['Type', 'Observed outcomes']),
    '## Request outcomes (up to 350; full catalog: resources.jsonl)', '',
    table(requests.slice(0, 350).map(r => [r.resourceType, displayMethod(r.method), r.httpStatus,
      r.status, displayOrigin(r.url), r.file || '']), ['Type', 'Method', 'HTTP', 'Capture', 'Origin', 'Saved artifact']),
    `Indexed resource outcomes: ${resources.length}; saved bodies: ${saved.length}; unresolved: ${resources.length - saved.length}.`, ''
  ];
  save(path.join(directory, 'NETWORK.md'), network.join('\n') + '\n');

  const scriptFiles = scripts.filter(s => s.status === 'saved');
  const js = ['# JavaScript and React evidence', '',
    'Debugger.scriptParsed and Debugger.getScriptSource preserve executed/compiled sources,',
    'including inline/evaluated code when Chromium exposes it. Minified code may obscure component names.', '',
    `Observed React DOM markers: ${Math.max(0, ...states.map(s => s.frameworks.reactDomMarkers))}.`,
    `Next.js __NEXT_DATA__ marker: ${states.some(s => s.frameworks.nextData) ? 'observed' : 'not observed'}.`,
    '', '## Best-effort runtime React component names', '',
    components.size ? `Recovered component-name count: ${components.size}; names remain private.` :
      'No component names recovered through DOM-attached React Fiber markers.',
    '', '## Compiled scripts (first 250; full catalog: scripts.jsonl)', '',
    table(scriptFiles.slice(0, 250).map(s => [displayOrigin(s.url), s.bytes, s.file,
      displayOrigin(s.sourceMapURL)]),
      ['Source origin', 'Bytes', 'Saved artifact', 'Source-map origin']),
    `Parsed script events: ${scripts.length}; saved sources: ${scriptFiles.length}.`, ''
  ];
  save(path.join(directory, 'SCRIPTS.md'), js.join('\n') + '\n');

  const transitions = states.slice(1).map(state => ({
    from: state.step - 1, to: state.step, cause: state.trigger,
    newControls: state.controls.filter(control => !states[state.step - 1].controls.some(
      previous => previous.selector === control.selector && previous.label === control.label)).length,
    urlChanged: state.url !== states[state.step - 1].url
  }));
  const mermaid = ['flowchart TD', ...states.map(state =>
    `    s${state.step}["DOM state ${state.step} · ${state.controls.length} controls"]`),
  ...transitions.map(item => `    s${item.from} -->|"${item.cause?.kind || 'observation'}${item.urlChanged ? ': URL changed' : ''}"| s${item.to}`)];
  const flows = ['# Observed transitions', '',
    'Edges represent actual passive scroll/observation steps; they are not inferred click navigation or verified business workflows.',
    '', '```mermaid', ...mermaid, '```', '',
    table(transitions.map(t => [t.from, t.to, '[private]', t.cause?.from, t.cause?.to,
      t.newControls, t.urlChanged]),
    ['From', 'To', 'Scroll container', 'Scroll from', 'Scroll to', 'New controls', 'URL changed']),
    '## Candidate interaction surfaces', '',
    'Links, buttons, tabs and forms discovered without activating them are inventoried in [DOM.md](DOM.md).',
    'Executing them safely requires an explicit scenario, permissions and often authenticated state.', ''
  ];
  save(path.join(directory, 'FLOWS.md'), flows.join('\n') + '\n');

  const dropped = Object.entries(summary.dropped || {}).filter(([,count]) => count > 0);
  const limited = states.filter(s => Object.values(s.truncated || {}).some(Boolean)).map(s => s.step);
  const nonSettled = states.filter(s => s.settlement?.status !== 'settled').map(s => s.step);
  const limits = ['# Coverage, confidence and limitations', '',
    'Evidence is limited to this browser profile, permissions, viewport, execution interval and observed route.',
    'A single visit cannot exhaust the states of a dynamic React application.', '',
    `- Observed DOM states: ${states.length} (bounded to ${LIMIT.steps + 1}).`,
    `- States without confirmed settlement: ${nonSettled.length ? nonSettled.join(', ') : 'none'}.`,
    `- Settlement: document complete, fonts loaded, DOM and network quiet for ${LIMIT.quietMs} ms, no pending reads or in-flight HTTP requests.`,
    `- Settlement time limits: initial ${LIMIT.initialSettleMs} ms; subsequent ${LIMIT.scrollSettleMs} ms.`,
    `- Requests still active after ${LIMIT.pendingQuietMs} ms of network quiet are recorded as dom-quiet-network-pending, never settled.`,
    `- Overall passive exploration time budget: ${LIMIT.analysisMs} ms.`,
    '- Continuous DOM mutation, requests, long-lived streams or late tasks can prevent settlement.',
    '- A settled observation is a bounded heuristic, not proof that all future work has finished.',
    '- `states/dom-rest-initial.html` and `states/dom-rest-final.html` contain full outerHTML if capture succeeded;',
    '  check adjacent JSON metadata and warnings, especially when settlement timed out.',
    `- DOM snapshots with truncated HTML/text/control inventories: ${limited.length ? limited.join(', ') : 'none observed'}.`,
    `- Event streams with dropped records: ${dropped.length ? JSON.stringify(dropped) : 'none reported'}.`,
    `- Post-capture file integrity: ${integrity?.status || 'unavailable'}; missing/corrupt: ${integrity?.counts?.missingOrCorrupt ?? 0}; discrepancies: ${integrity?.counts?.discrepancies ?? 0}.`,
    '- Per-target and per-domain outcomes are in evidence-integrity.json; a saved file is not proof that the page domain was fully observed.',
    `- Raw DOM mutation writer: ${summary.resourceCapture?.domHistory?.status || 'unavailable'}; write errors: ${summary.resourceCapture?.domHistory?.errors?.length ?? 0}; truncated serialized values: ${summary.resourceCapture?.domHistory?.truncatedValues ?? 0}.`,
    '- Per-document observer and ShadowRoot hook health: rest/dom-history-contexts.json.',
    '- Callback-time DOM snapshots are not atomic history of every synchronous intermediate value;',
    '  elements attached and removed within one turn can be observable, but pre-attachment',
    '  mutations, earlier closed roots and detached/opaque frames may remain unobserved.',
    `- Response bodies unavailable/redirected/unfinished: ${resources.length - saved.length}.`,
    `- Partial stream artifacts: ${summary.resourceCapture?.partialStreams ?? 0}.`,
    `- CDP response buffer configuration outcomes: ${JSON.stringify((summary.resourceCapture?.networkConfiguration || []).map(x => ({enabled:x.enabled, durable:x.durable})))}.`,
    '- Streaming is bounded to 16 MiB per active request and 64 MiB across streams;',
    '  additional bytes are not reconstructed from the bounded stream buffer.',
    `- Script source failures: ${summary.resourceCapture?.scriptsFailed ?? 'unknown'}.`,
    `- Observation interrupted: ${interrupted}.`,
    '', '## Not established by this run', '',
    '- No exhaustive behavior or component completeness guarantee; server-side logic and unvisited routes remain unknown.',
    '- No automatic link clicks, form submissions, logins, payments, consent changes or challenge bypass.',
    '- Mutation chronology records observed node changes but does not prove their',
    '  causal source or reconstruct every user state; scroll transitions are not causal evidence.',
    '- CDP may miss resources on redirects, websocket streams, caches, service workers or debugger attachment races.',
    '- HTTP redirect bodies are generally unavailable; response and redirect metadata remain separately indexed.',
    '- Network.getResponseBody is preferred for completed responses; supported streamed content and',
    '  Page.getResourceContent are read-only fallbacks when the primary body is unavailable.',
    '- Initial rest evidence includes CDP tree, layout/styling, event listeners, runtime state and native MHTML when supported.',
    '- Target discovery and attached worker/iframe context inventory are saved in rest/target-graph-final.json;',
    '  unattached and unready relevant targets are explicitly distinguished from attached contexts.',
    '- Rest files were captured before any programmed scroll, but are not an atomic snapshot of one instant.',
    `- Rest evidence status: ${rest?.status || 'unavailable'}.`,
    '- Loaded resources and script sources are preserved in the root archive; private network events are in network-details.jsonl.',
    `- Raw connected-CDP packet ledger: ${summary.resourceCapture?.wireCapture?.status || 'unavailable'}; write errors: ${summary.resourceCapture?.wireCapture?.errors?.length ?? 0}.`,
    `- Browser-specific CDP schema retrieval: ${capabilities?.protocol?.status || 'unavailable'}.`,
    '- No source map resolution, unexecuted JavaScript extraction, or reconstruction of hidden React state.',
    '- Page content and React internals can change with authentication, locale, A/B tests or timing.',
    '', '## Warnings', '', `- Count: ${warnings.length}; private details remain in capture diagnostics.`, ''
  ];
  save(path.join(directory, 'LIMITATIONS.md'), limits.join('\n') + '\n');
}

async function main(args)
{
  if (!process.env.m_ROOT)
    throw failure(1, 'm-environment-missing', 'invoke through m or initialize m_ROOT first');
  if (![2,3].includes(args.length) || args.some(arg => !arg) ||
      (args.length === 3 && args[2] !== '--scroll'))
    throw failure(2, 'invalid-arguments',
      'usage: web-analyze <http(s)-url> <analysis-path> [--scroll]');
  let url;
  try {url = new URL(args[0]);}
  catch (_) {throw failure(3, 'invalid-url', 'first operand must be an absolute HTTP(S) URL');}
  if (!['http:', 'https:'].includes(url.protocol))
    throw failure(4, 'invalid-url-scheme', 'only HTTP and HTTPS are supported');
  if (!process.env.m_LIB_DIR)
    throw failure(6, 'm-library-root-missing', 'm_LIB_DIR is unavailable');
  let startWebAnalyze;
  let captureRestEvidence;
  let auditWebAnalyzeEvidence;
  try
  {
    ({startWebAnalyze} = require(path.join(process.env.m_LIB_DIR, 'sys/js/web-analyze.lib.js')));
    ({captureRestEvidence, auditWebAnalyzeEvidence} = require(
      path.join(process.env.m_LIB_DIR, 'sys/js/web-analyze-rest.lib.js')));
  }
  catch (error) {throw failure(7, 'capture-library-unavailable', error.message);}
  const directory = runDirectory(path.resolve(args[1]));
  process.stderr.write(`web-analyze: capture started in ${directory}\n`);
  let session;
  let interrupted = false;
  const onSignal = () => {interrupted = true;};
  process.once('SIGINT', onSignal);
  process.once('SIGTERM', onSignal);
  const warnings = [];
  let states = [];
  let summary;
  try
  {
    try {session = await startWebAnalyze({url: url.href, outputDir: directory, headless: true,
      cssRuleUsage: true});}
    catch (error) {throw failure(8, 'chromium-capture-start-failed', error.message);}
    states = await explore(session, directory, warnings, () => interrupted,
      captureRestEvidence, args[2] === '--scroll');
  }
  finally
  {
    if (session)
    {
      try {summary = await session.stop(interrupted ? 'signal' : 'automated-analysis');}
      catch (error) {warnings.push(`capture shutdown: ${error.message}`);}
    }
    process.off('SIGINT', onSignal);
    process.off('SIGTERM', onSignal);
  }
  if (!summary)
    throw failure(9, 'capture-finalization-failed', `recording did not finalize in ${directory}`);
  let integrity;
  try
  {
    integrity = auditWebAnalyzeEvidence(directory, {write:true, interrupted});
    if (integrity.status !== 'saved')
      warnings.push('Evidence integrity/coverage status: ' + integrity.status +
        '; inspect evidence-integrity.json');
  }
  catch (error)
  {
    throw failure(13, 'evidence-integrity-unavailable',
      'Cannot write integrity result in ' + directory + ': ' + error.message);
  }
  try {documentReports(directory, url.href, states, summary, warnings, interrupted,
    args[2] === '--scroll', integrity);}
  catch (error) {throw failure(10, 'report-generation-failed', `${directory}: ${error.message}`);}
  if (!states.length)
    throw failure(11, 'document-not-observed', `no rendered DOM was captured; inspect ${directory}/LIMITATIONS.md`);
  process.stdout.write(`${directory}/README.md\n`);
  return 0;
}

main(process.argv.slice(2)).then(status => {process.exitCode = status;}, error => {
  process.stderr.write(`web-analyze.${error.identity || 'unexpected-failure'}: ${error.message}\n`);
  process.exitCode = error.status || 12;
});
