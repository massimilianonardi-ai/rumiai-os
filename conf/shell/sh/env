if [ -n "${m_SHELL_ENV-}" ] && [ -r "$m_SHELL_ENV" ]
then
  . "$m_SHELL_ENV"
fi

unset m_SHELL_ENV

. "$m_LIB_DIR/sh/core.lib.sh"

export PS1="$(tput setaf 7)$(tput bold)${m_OS_NAME}:${m_SHELL_NAME}$(tput sgr0) $(tput setaf 2)\$(whoami)$(tput setaf 7)@$(tput setaf 2)\$(hostname)$(tput setaf 7):\$(tput setaf 2)\$(pwd)\$(tput setaf 4) \$(if [ \$(id -u) -eq 0 ]; then echo '#'; else echo '$'; fi)$(tput sgr0) "

if [ -f "$m_SHELL_EXT" ] && [ -r "$m_SHELL_EXT" ]
then
  . "$m_SHELL_EXT"
fi
