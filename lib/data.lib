# RumiAI system data APIs.
# Public functions use POSIX sh and POSIX awk only.
# Status: 0 success, 1 negative query/not found, 2 invalid or malformed data, 3 I/O failure.

RumiAI_data_value_valid()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_DATA_VALUE=$1
  export RumiAI_DATA_VALUE
  command -p awk '
    BEGIN {
      v=ENVIRON["RumiAI_DATA_VALUE"]
      exit (index(v,"\t") || index(v,"\r") || index(v,"\n")) ? 1 : 0
    }
  '
)

RumiAI_conf_key_valid()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_DATA_QUERY=$1
  export RumiAI_DATA_QUERY
  command -p awk '
    function name(s)  { return s ~ /^[A-Za-z_][A-Za-z0-9_]*$/ }
    function indexn(s){ return s ~ /^[1-9][0-9]*$/ }
    function key(s, a,n,i) {
      n=split(s,a,".")
      if (n < 1 || !name(a[1])) return 0
      for (i=2; i<=n; i++) if (!name(a[i]) && !indexn(a[i])) return 0
      return 1
    }
    BEGIN { exit key(ENVIRON["RumiAI_DATA_QUERY"]) ? 0 : 1 }
  '
)

RumiAI_conf_scan()
(
  [ "$#" -ge 2 ] || return 2
  RumiAI_DATA_MODE=$1
  RumiAI_DATA_FILE=$2
  RumiAI_DATA_QUERY=${3-}
  [ -f "$RumiAI_DATA_FILE" ] && [ -r "$RumiAI_DATA_FILE" ] || return 3
  export RumiAI_DATA_MODE RumiAI_DATA_QUERY

  command -p awk '
    function name(s)  { return s ~ /^[A-Za-z_][A-Za-z0-9_]*$/ }
    function indexn(s){ return s ~ /^[1-9][0-9]*$/ }
    function valid_key(s, a,n,i) {
      n=split(s,a,".")
      if (n < 1 || !name(a[1])) return 0
      for (i=2; i<=n; i++) if (!name(a[i]) && !indexn(a[i])) return 0
      return 1
    }
    function register_key(s, a,n,i,p) {
      if (seen[s] || namespace[s]) return 0
      n=split(s,a,".")
      p=a[1]
      for (i=2; i<=n; i++) {
        if (seen[p]) return 0
        namespace[p]=1
        p=p "." a[i]
      }
      seen[s]=1
      return 1
    }
    BEGIN {
      mode=ENVIRON["RumiAI_DATA_MODE"]
      query=ENVIRON["RumiAI_DATA_QUERY"]
      if (mode != "validate" && !valid_key(query)) exit 2
      found=0; bad=0; outn=0
    }
    {
      line=$0
      if (index(line,"\r")) { bad=1; next }
      if (line == "" || substr(line,1,1) == "#") next
      tab=index(line,"\t")
      if (!tab || index(substr(line,tab+1),"\t")) { bad=1; next }
      k=substr(line,1,tab-1)
      v=substr(line,tab+1)
      if (!valid_key(k) || !register_key(k)) { bad=1; next }

      if (mode == "get" && k == query) {
        out[++outn]=v; found=1
      } else if (mode == "has" && k == query) {
        found=1
      } else if (mode == "namespace" && (k == query || substr(k,1,length(query)+1) == query ".")) {
        out[++outn]=k "\t" v; found=1
      }
    }
    END {
      if (bad) exit 2
      if (mode == "validate") exit 0
      if (!found) exit 1
      for (i=1; i<=outn; i++) print out[i]
      exit 0
    }
  ' "$RumiAI_DATA_FILE"
)

rumi_conf_validate() { [ "$#" -eq 1 ] || return 2; RumiAI_conf_scan validate "$1"; }
rumi_conf_get()      { [ "$#" -eq 2 ] || return 2; RumiAI_conf_scan get "$1" "$2"; }
rumi_conf_has()      { [ "$#" -eq 2 ] || return 2; RumiAI_conf_scan has "$1" "$2" >/dev/null; }
rumi_conf_namespace(){ [ "$#" -eq 2 ] || return 2; RumiAI_conf_scan namespace "$1" "$2"; }

RumiAI_data_tempdir()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_DATA_PARENT=$1
  RumiAI_DATA_I=0
  while [ "$RumiAI_DATA_I" -lt 100 ]
  do
    RumiAI_DATA_TMP=$RumiAI_DATA_PARENT/.rumi-data-$$-$RumiAI_DATA_I
    if (umask 077 && command -p mkdir "$RumiAI_DATA_TMP" 2>/dev/null)
    then
      printf -- '%s\n' "$RumiAI_DATA_TMP"
      return 0
    fi
    RumiAI_DATA_I=$((RumiAI_DATA_I + 1))
  done
  return 3
)

rumi_conf_set()
(
  [ "$#" -eq 3 ] || return 2
  RumiAI_DATA_FILE=$1
  RumiAI_DATA_KEY=$2
  RumiAI_DATA_VALUE=$3
  RumiAI_conf_key_valid "$RumiAI_DATA_KEY" || return 2
  RumiAI_data_value_valid "$RumiAI_DATA_VALUE" || return 2

  if [ -e "$RumiAI_DATA_FILE" ]
  then
    [ -f "$RumiAI_DATA_FILE" ] && [ -r "$RumiAI_DATA_FILE" ] || return 3
    rumi_conf_validate "$RumiAI_DATA_FILE" || return 2
  fi

  RumiAI_DATA_PARENT=${RumiAI_DATA_FILE%/*}
  [ "$RumiAI_DATA_PARENT" != "$RumiAI_DATA_FILE" ] || RumiAI_DATA_PARENT=.
  [ -d "$RumiAI_DATA_PARENT" ] && [ -w "$RumiAI_DATA_PARENT" ] || return 3
  RumiAI_DATA_TMPDIR=$(RumiAI_data_tempdir "$RumiAI_DATA_PARENT") || return 3
  trap 'command -p rm -rf "$RumiAI_DATA_TMPDIR"' 0 HUP INT TERM
  RumiAI_DATA_TMP=$RumiAI_DATA_TMPDIR/file
  RumiAI_DATA_QUERY=$RumiAI_DATA_KEY
  RumiAI_DATA_NEW_VALUE=$RumiAI_DATA_VALUE
  export RumiAI_DATA_QUERY RumiAI_DATA_NEW_VALUE

  if [ -e "$RumiAI_DATA_FILE" ]
  then
    command -p awk '
      BEGIN { q=ENVIRON["RumiAI_DATA_QUERY"]; v=ENVIRON["RumiAI_DATA_NEW_VALUE"]; done=0 }
      {
        line=$0; tab=index(line,"\t")
        if (line != "" && substr(line,1,1) != "#" && tab && substr(line,1,tab-1) == q) {
          print q "\t" v; done=1
        } else print line
      }
      END { if (!done) print q "\t" v }
    ' "$RumiAI_DATA_FILE" > "$RumiAI_DATA_TMP" || return 3
  else
    (umask 077; printf -- '%s\t%s\n' "$RumiAI_DATA_KEY" "$RumiAI_DATA_VALUE" > "$RumiAI_DATA_TMP") || return 3
  fi

  rumi_conf_validate "$RumiAI_DATA_TMP" || return 2
  command -p chmod 600 "$RumiAI_DATA_TMP" 2>/dev/null || return 3
  command -p mv -f "$RumiAI_DATA_TMP" "$RumiAI_DATA_FILE" || return 3
  trap - 0 HUP INT TERM
  command -p rmdir "$RumiAI_DATA_TMPDIR" 2>/dev/null || :
  return 0
)

rumi_conf_remove()
(
  [ "$#" -eq 2 ] || return 2
  RumiAI_DATA_FILE=$1
  RumiAI_DATA_KEY=$2
  RumiAI_conf_key_valid "$RumiAI_DATA_KEY" || return 2
  [ -f "$RumiAI_DATA_FILE" ] && [ -r "$RumiAI_DATA_FILE" ] || return 3
  rumi_conf_validate "$RumiAI_DATA_FILE" || return 2
  rumi_conf_has "$RumiAI_DATA_FILE" "$RumiAI_DATA_KEY" || return $?

  RumiAI_DATA_PARENT=${RumiAI_DATA_FILE%/*}
  [ "$RumiAI_DATA_PARENT" != "$RumiAI_DATA_FILE" ] || RumiAI_DATA_PARENT=.
  [ -d "$RumiAI_DATA_PARENT" ] && [ -w "$RumiAI_DATA_PARENT" ] || return 3
  RumiAI_DATA_TMPDIR=$(RumiAI_data_tempdir "$RumiAI_DATA_PARENT") || return 3
  trap 'command -p rm -rf "$RumiAI_DATA_TMPDIR"' 0 HUP INT TERM
  RumiAI_DATA_TMP=$RumiAI_DATA_TMPDIR/file
  RumiAI_DATA_QUERY=$RumiAI_DATA_KEY
  export RumiAI_DATA_QUERY

  command -p awk '
    BEGIN { q=ENVIRON["RumiAI_DATA_QUERY"] }
    {
      line=$0; tab=index(line,"\t")
      if (line != "" && substr(line,1,1) != "#" && tab && substr(line,1,tab-1) == q) next
      print line
    }
  ' "$RumiAI_DATA_FILE" > "$RumiAI_DATA_TMP" || return 3

  rumi_conf_validate "$RumiAI_DATA_TMP" || return 2
  command -p chmod 600 "$RumiAI_DATA_TMP" 2>/dev/null || return 3
  command -p mv -f "$RumiAI_DATA_TMP" "$RumiAI_DATA_FILE" || return 3
  trap - 0 HUP INT TERM
  command -p rmdir "$RumiAI_DATA_TMPDIR" 2>/dev/null || :
  return 0
)

RumiAI_table_scan()
(
  [ "$#" -ge 2 ] || return 2
  RumiAI_DATA_MODE=$1
  RumiAI_DATA_FILE=$2
  shift 2
  [ -f "$RumiAI_DATA_FILE" ] && [ -r "$RumiAI_DATA_FILE" ] || return 3

  RumiAI_DATA_EXPECTED=
  if [ "$RumiAI_DATA_MODE" = validate ]
  then
    for RumiAI_DATA_FIELD in "$@"
    do
      case $RumiAI_DATA_FIELD in
        ''|*[!A-Za-z0-9_]*) return 2 ;;
      esac
      case $RumiAI_DATA_FIELD in
        [0-9]*) return 2 ;;
      esac
      RumiAI_DATA_EXPECTED=${RumiAI_DATA_EXPECTED}${RumiAI_DATA_EXPECTED:+,}$RumiAI_DATA_FIELD
    done
  fi
  export RumiAI_DATA_MODE RumiAI_DATA_EXPECTED

  command -p awk -F '\t' '
    function field_name(s) { return s ~ /^[A-Za-z_][A-Za-z0-9_]*$/ }
    BEGIN { mode=ENVIRON["RumiAI_DATA_MODE"]; expected=ENVIRON["RumiAI_DATA_EXPECTED"]; header_done=0; bad=0 }
    NR == 1 {
      if (index($0,"\r") || NF < 1) { bad=1; next }
      columns=NF
      header=$0
      for (i=1; i<=NF; i++) {
        if (!field_name($i) || header_seen[$i]++) bad=1
        header_index[$i]=i
      }
      if (expected != "") {
        n=split(expected,e,",")
        if (n != NF) bad=1
        else for (i=1; i<=NF; i++) if ($i != e[i]) bad=1
      }
      header_done=1
      if (mode == "column" || mode == "select") {
        c=ENVIRON["RumiAI_DATA_FIELD"]
        if (!(c in header_index)) missing_field=1
      }
      if (mode == "header" && !bad) print header
      next
    }
    {
      if (index($0,"\r") || NF != columns) { bad=1; next }
      if (mode == "rows") print $0
      else if (mode == "column") {
        c=ENVIRON["RumiAI_DATA_FIELD"]
        if (!(c in header_index)) { missing_field=1; next }
        print $header_index[c]
      }
      else if (mode == "select") {
        c=ENVIRON["RumiAI_DATA_FIELD"]
        v=ENVIRON["RumiAI_DATA_VALUE"]
        if (!(c in header_index)) { missing_field=1; next }
        if ($header_index[c] == v) { print $0; found=1 }
      }
    }
    END {
      if (!header_done || bad) exit 2
      if ((mode == "column" || mode == "select") && missing_field) exit 1
      if (mode == "select" && !found) exit 1
      exit 0
    }
  ' "$RumiAI_DATA_FILE"
)

rumi_table_validate() { [ "$#" -ge 1 ] || return 2; RumiAI_DATA_FILE=$1; shift; RumiAI_table_scan validate "$RumiAI_DATA_FILE" "$@" >/dev/null; }
rumi_table_header()   { [ "$#" -eq 1 ] || return 2; RumiAI_table_scan header "$1"; }
rumi_table_rows()     { [ "$#" -eq 1 ] || return 2; RumiAI_table_scan rows "$1"; }

rumi_table_column()
(
  [ "$#" -eq 2 ] || return 2
  RumiAI_DATA_FIELD=$2
  export RumiAI_DATA_FIELD
  RumiAI_table_scan column "$1"
)

rumi_table_select()
(
  [ "$#" -eq 3 ] || return 2
  RumiAI_DATA_FIELD=$2
  RumiAI_DATA_VALUE=$3
  RumiAI_data_value_valid "$RumiAI_DATA_VALUE" || return 2
  export RumiAI_DATA_FIELD RumiAI_DATA_VALUE
  RumiAI_table_scan select "$1"
)
