lang()
(
  [ "$#" -eq 2 ] || return 1

  RumiAI_lang_domain=$1
  RumiAI_lang_message_id=$2

  case "$RumiAI_LANGUAGE" in [[:lower:]][[:lower:]]_[[:upper:]][[:upper:]]) true;; *) false;; esac && RumiAI_text_safe_id "$RumiAI_lang_domain" && RumiAI_text_safe_id "$RumiAI_lang_message_id" || return 2

  # RumiAI_lang_file=$RumiAI_LANG_DIR/$RumiAI_LANGUAGE/$RumiAI_lang_domain/$RumiAI_lang_message_id
  #
  # if ! RumiAI_lang_message="$(command -p -- cat "$RumiAI_lang_file" 2>/dev/null)" && [ "$RumiAI_LANGUAGE" != "$RumiAI_LANGUAGE_FALLBACK" ]
  # then
  #   RumiAI_lang_file=$RumiAI_LANG_DIR/$RumiAI_LANGUAGE_FALLBACK/$RumiAI_lang_domain/$RumiAI_lang_message_id
  #   if ! RumiAI_lang_message="$(command -p -- cat "$RumiAI_lang_file" 2>/dev/null)"
  #   then
  #     :
  #   fi
  # fi

  RumiAI_lang_message="$(command -p -- cat "$RumiAI_LANG_DIR/$RumiAI_LANGUAGE/$RumiAI_lang_domain/$RumiAI_lang_message_id" 2>/dev/null)"
  if [ "$?" != 0 ]
  then
    [ "$RumiAI_LANGUAGE" != "$RumiAI_LANGUAGE_FALLBACK" ] && case "$RumiAI_LANGUAGE_FALLBACK" in [[:lower:]][[:lower:]]_[[:upper:]][[:upper:]]) true;; *) false;; esac && RumiAI_lang_message="$(command -p -- cat "$RumiAI_LANG_DIR/$RumiAI_LANGUAGE_FALLBACK/$RumiAI_lang_domain/$RumiAI_lang_message_id" 2>/dev/null)"
    if [ "$?" != 0 ]
    then
      RumiAI_lang_message="${RumiAI_lang_domain}.${RumiAI_lang_message_id}"
    fi
  fi

  printf -- '%s\n' "$RumiAI_lang_message"
)
