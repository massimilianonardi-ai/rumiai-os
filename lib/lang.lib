
RumiAI_lang_init()
{
  # conf files
  RumiAI_CONF_FILE_LANG_LANGUAGE=$RumiAI_CONF_DIR/lang/language
  RumiAI_CONF_FILE_LANG_TEXT_ENCODING=$RumiAI_CONF_DIR/lang/text-encoding

  # set var - language
  # if ! IFS= read -r RumiAI_LANGUAGE < "$RumiAI_CONF_FILE_LANG_LANGUAGE"
  if ! RumiAI_LANGUAGE="$(cat "$RumiAI_CONF_FILE_LANG_LANGUAGE")"
  then
    printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_LANG_LANGUAGE_LOAD_ERROR' >&2
    RumiAI_LANGUAGE=en_US
  fi

  RumiAI_LANGUAGE_FALLBACK=en_US

  # set var - text encoding
  # if ! IFS= read -r RumiAI_TEXT_ENCODING < "$RumiAI_CONF_FILE_LANG_TEXT_ENCODING"
  if ! RumiAI_TEXT_ENCODING="(cat "$RumiAI_CONF_FILE_LANG_TEXT_ENCODING")"
  then
    printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_LANG_TEXT_ENCODING_LOAD_ERROR' >&2
    RumiAI_TEXT_ENCODING=UTF-8
  fi

  # supported encodings
  case $RumiAI_TEXT_ENCODING in
    UTF-8 | utf-8)
      RumiAI_TEXT_ENCODING=UTF-8
      ;;
    *)
      RumiAI_TEXT_ENCODING=UTF-8
      ;;
  esac

  # unset variables
  unset -v -- RumiAI_CONF_FILE_LANG_LANGUAGE RumiAI_CONF_FILE_LANG_TEXT_ENCODING
}

RumiAI_lang_read_message()
(
  [ "$#" -eq 1 ] || return 2

  RumiAI_lang_file=$1

  # if ! IFS= read -r RumiAI_lang_message < "$RumiAI_lang_file"
  if [ -f "$RumiAI_lang_file" ] || [ -r "$RumiAI_lang_file" ] || ! RumiAI_lang_message="$(cat "$RumiAI_lang_file")"
  then
    return 1
  fi

  printf -- '%s\n' "$RumiAI_lang_message"
)

lang()
(
  [ "$#" -eq 2 ] || return 2

  RumiAI_lang_domain=$1
  RumiAI_lang_message_id=$2

  RumiAI_lang_file=$RumiAI_LANG_DIR/$RumiAI_LANGUAGE/$RumiAI_lang_domain/$RumiAI_lang_message_id

  if RumiAI_lang_read_message "$RumiAI_lang_file"
  then
    return 0
  fi

  if [ "$RumiAI_LANGUAGE" != "$RumiAI_LANGUAGE_FALLBACK" ]
  then
    RumiAI_lang_file=$RumiAI_LANG_DIR/$RumiAI_LANGUAGE_FALLBACK/$RumiAI_lang_domain/$RumiAI_lang_message_id

    if RumiAI_lang_read_message "$RumiAI_lang_file"
    then
      return 0
    fi
  fi

  printf -- '%s.%s\n' "$RumiAI_lang_domain" "$RumiAI_lang_message_id"
)
