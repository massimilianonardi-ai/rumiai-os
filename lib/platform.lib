# RumiAI bootstrap platform adapter.
# Public functions use POSIX sh plus host facilities selected centrally here.
# Status: 0 success, 1 negative/not found, 2 invalid/unsupported input, 3 host/I/O failure.

RumiAI_platform_detect_os()
(
  [ "$#" -eq 0 ] || return 2
  RumiAI_PLATFORM_UNAME=$(command -p uname -s 2>/dev/null) || return 3

  case $RumiAI_PLATFORM_UNAME in
    Linux)
      printf '%s\n' linux
      ;;
    Darwin)
      printf '%s\n' macos
      ;;
    MINGW*|MSYS*|CYGWIN*)
      printf '%s\n' windows
      ;;
    *)
      return 3
      ;;
  esac
)

RumiAI_platform_detect_architecture()
(
  [ "$#" -eq 0 ] || return 2
  RumiAI_PLATFORM_UNAME=$(command -p uname -m 2>/dev/null) || return 3

  case $RumiAI_PLATFORM_UNAME in
    arm64|aarch64)
      printf '%s\n' arm64
      ;;
    x86_64|amd64|AMD64)
      printf '%s\n' x86_64
      ;;
    *)
      return 3
      ;;
  esac
)

RumiAI_platform()
{
  [ "$#" -eq 0 ] || return 2
  [ -n "${RumiAI_PLATFORM-}" ] || return 3
  printf '%s\n' "$RumiAI_PLATFORM"
}

RumiAI_architecture()
{
  [ "$#" -eq 0 ] || return 2
  [ -n "${RumiAI_ARCHITECTURE-}" ] || return 3
  printf '%s\n' "$RumiAI_ARCHITECTURE"
}

RumiAI_execution_platform()
{
  [ "$#" -eq 0 ] || return 2
  [ -n "${RumiAI_EXECUTION_PLATFORM-}" ] || return 3
  printf '%s\n' "$RumiAI_EXECUTION_PLATFORM"
}

RumiAI_fs_absolute_path()
(
  [ "$#" -eq 1 ] || return 2
  case $1 in
    /*)
      printf '%s\n' "$1"
      ;;
    *)
      printf '%s/%s\n' "$PWD" "$1"
      ;;
  esac
)

RumiAI_fs_type()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_FS_PATH=$(RumiAI_fs_absolute_path "$1") || return 2

  if [ -L "$RumiAI_FS_PATH" ]
  then
    printf '%s\n' link
    return 0
  fi

  [ -e "$RumiAI_FS_PATH" ] || return 1

  if [ -f "$RumiAI_FS_PATH" ]
  then
    printf '%s\n' file
  elif [ -d "$RumiAI_FS_PATH" ]
  then
    printf '%s\n' directory
  else
    printf '%s\n' other
  fi
)

RumiAI_fs_mode()
(
  [ "$#" -eq 1 ] || return 2
  [ ! -L "$1" ] || return 2
  RumiAI_FS_PATH=$(RumiAI_path_canonicalize_existing "$1") || return 1

  case ${RumiAI_PLATFORM-} in
    linux)
      RumiAI_FS_MODE=$(command -p stat -c '%a' "$RumiAI_FS_PATH" 2>/dev/null) || return 3
      ;;
    macos)
      RumiAI_FS_MODE=$(command -p stat -f '%Lp' "$RumiAI_FS_PATH" 2>/dev/null) || return 3
      ;;
    *)
      return 3
      ;;
  esac

  case $RumiAI_FS_MODE in
    ''|*[!0-7]*) return 3 ;;
  esac

  printf '%04d\n' "$RumiAI_FS_MODE"
)

RumiAI_fs_readlink()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_FS_PATH=$(RumiAI_fs_absolute_path "$1") || return 2
  [ -L "$RumiAI_FS_PATH" ] || return 1
  command -p readlink "$RumiAI_FS_PATH" || return 3
)

RumiAI_digest_normalize_sha256()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_DIGEST_VALUE=${1%% *}

  [ "${#RumiAI_DIGEST_VALUE}" -eq 64 ] || return 3
  case $RumiAI_DIGEST_VALUE in
    *[!0-9A-Fa-f]*) return 3 ;;
  esac

  printf '%s\n' "$RumiAI_DIGEST_VALUE" | command -p tr 'A-F' 'a-f'
)

RumiAI_digest_sha256_file()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_DIGEST_FILE=$1

  case ${RumiAI_PLATFORM-} in
    linux)
      RumiAI_DIGEST_OUTPUT=$(command -p sha256sum "$RumiAI_DIGEST_FILE" 2>/dev/null) || return 3
      ;;
    macos)
      RumiAI_DIGEST_OUTPUT=$(command -p shasum -a 256 "$RumiAI_DIGEST_FILE" 2>/dev/null) || return 3
      ;;
    *)
      return 3
      ;;
  esac

  RumiAI_digest_normalize_sha256 "$RumiAI_DIGEST_OUTPUT"
)

RumiAI_digest_sha256_text()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_DIGEST_TEXT=$1

  case ${RumiAI_PLATFORM-} in
    linux)
      RumiAI_DIGEST_OUTPUT=$(printf '%s' "$RumiAI_DIGEST_TEXT" | command -p sha256sum 2>/dev/null) || return 3
      ;;
    macos)
      RumiAI_DIGEST_OUTPUT=$(printf '%s' "$RumiAI_DIGEST_TEXT" | command -p shasum -a 256 2>/dev/null) || return 3
      ;;
    *)
      return 3
      ;;
  esac

  RumiAI_digest_normalize_sha256 "$RumiAI_DIGEST_OUTPUT"
)

RumiAI_digest_file()
(
  [ "$#" -eq 2 ] || return 2
  [ "$1" = sha256 ] || return 2
  [ -f "$2" ] && [ ! -L "$2" ] || return 1
  RumiAI_DIGEST_FILE=$(RumiAI_path_canonicalize_existing "$2") || return 1
  RumiAI_digest_sha256_file "$RumiAI_DIGEST_FILE"
)

RumiAI_digest_text()
(
  [ "$#" -eq 2 ] || return 2
  [ "$1" = sha256 ] || return 2
  RumiAI_digest_sha256_text "$2"
)

RumiAI_path_parent()
(
  [ "$#" -eq 1 ] || return 2
  case $1 in
    */*)
      RumiAI_PARENT=${1%/*}
      [ -n "$RumiAI_PARENT" ] || RumiAI_PARENT=/
      ;;
    *)
      RumiAI_PARENT=.
      ;;
  esac
  printf '%s\n' "$RumiAI_PARENT"
)

RumiAI_path_name()
(
  [ "$#" -eq 1 ] || return 2
  RumiAI_NAME=${1##*/}
  case $RumiAI_NAME in
    ''|.|..) return 2 ;;
  esac
  printf '%s\n' "$RumiAI_NAME"
)

RumiAI_atomic_replace()
(
  [ "$#" -eq 2 ] || return 2

  RumiAI_ATOMIC_SOURCE_PARENT=$(RumiAI_path_parent "$1") || return 2
  RumiAI_ATOMIC_SOURCE_NAME=$(RumiAI_path_name "$1") || return 2
  RumiAI_ATOMIC_DEST_PARENT=$(RumiAI_path_parent "$2") || return 2
  RumiAI_ATOMIC_DEST_NAME=$(RumiAI_path_name "$2") || return 2

  RumiAI_ATOMIC_SOURCE_PARENT=$(RumiAI_path_canonicalize_existing "$RumiAI_ATOMIC_SOURCE_PARENT") || return 1
  RumiAI_ATOMIC_DEST_PARENT=$(RumiAI_path_canonicalize_existing "$RumiAI_ATOMIC_DEST_PARENT") || return 1

  [ "$RumiAI_ATOMIC_SOURCE_PARENT" = "$RumiAI_ATOMIC_DEST_PARENT" ] || return 2

  RumiAI_ATOMIC_SOURCE=$RumiAI_ATOMIC_SOURCE_PARENT/$RumiAI_ATOMIC_SOURCE_NAME
  RumiAI_ATOMIC_DEST=$RumiAI_ATOMIC_DEST_PARENT/$RumiAI_ATOMIC_DEST_NAME

  [ -e "$RumiAI_ATOMIC_SOURCE" ] || [ -L "$RumiAI_ATOMIC_SOURCE" ] || return 1

  command -p mv -f "$RumiAI_ATOMIC_SOURCE" "$RumiAI_ATOMIC_DEST" || return 3
)

# The v0 package-manager mutation lock reserves file descriptor 9 while held.
# The lock pathname is persistent/non-authoritative; ownership is kernel-backed.
RumiAI_lock_acquire()
{
  [ "$#" -eq 1 ] || return 2
  [ -z "${RumiAI_LOCK_HANDLE-}" ] || return 2

  RumiAI_LOCK_PARENT=$(RumiAI_path_parent "$1") || return 2
  RumiAI_LOCK_NAME=$(RumiAI_path_name "$1") || {
    unset RumiAI_LOCK_PARENT
    return 2
  }
  RumiAI_LOCK_PARENT=$(RumiAI_path_canonicalize_existing "$RumiAI_LOCK_PARENT") || {
    unset RumiAI_LOCK_PARENT RumiAI_LOCK_NAME
    return 1
  }
  [ -d "$RumiAI_LOCK_PARENT" ] || {
    unset RumiAI_LOCK_PARENT RumiAI_LOCK_NAME
    return 1
  }

  RumiAI_LOCK_PATH=$RumiAI_LOCK_PARENT/$RumiAI_LOCK_NAME
  if [ -L "$RumiAI_LOCK_PATH" ] || { [ -e "$RumiAI_LOCK_PATH" ] && [ ! -f "$RumiAI_LOCK_PATH" ]; }
  then
    unset RumiAI_LOCK_PARENT RumiAI_LOCK_NAME RumiAI_LOCK_PATH
    return 2
  fi

  exec 9>>"$RumiAI_LOCK_PATH"

  case ${RumiAI_PLATFORM-} in
    linux)
      command -p -- flock -n -E 75 -- 9 >/dev/null 2>&1
      RumiAI_LOCK_STATUS=$?
      ;;
    macos)
      command -p -- lockf -s -t 0 9 >/dev/null 2>&1
      RumiAI_LOCK_STATUS=$?
      ;;
    *)
      RumiAI_LOCK_STATUS=127
      ;;
  esac

  if [ "$RumiAI_LOCK_STATUS" -ne 0 ]
  then
    exec 9>&-
    unset RumiAI_LOCK_PARENT RumiAI_LOCK_NAME RumiAI_LOCK_PATH
    if [ "$RumiAI_LOCK_STATUS" -eq 75 ]
    then
      unset RumiAI_LOCK_STATUS
      return 1
    fi
    unset RumiAI_LOCK_STATUS
    return 3
  fi

  RumiAI_LOCK_HANDLE=9
  unset RumiAI_LOCK_PARENT RumiAI_LOCK_NAME RumiAI_LOCK_STATUS
  return 0
}

RumiAI_lock_release()
{
  [ "$#" -eq 1 ] || return 2
  [ -n "${RumiAI_LOCK_HANDLE-}" ] || return 1
  [ "$1" = "$RumiAI_LOCK_HANDLE" ] || return 2
  [ "$RumiAI_LOCK_HANDLE" = 9 ] || return 3

  exec 9>&-
  unset RumiAI_LOCK_HANDLE RumiAI_LOCK_PATH
  return 0
}

# v0 deliberately uses the host-wide sync barrier. This is broader than a
# per-path fsync but avoids adding a bootstrap runtime/helper dependency.
RumiAI_file_sync()
(
  [ "$#" -eq 1 ] || return 2
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  command -p -- sync >/dev/null 2>&1 || return 3
)

RumiAI_directory_sync()
(
  [ "$#" -eq 1 ] || return 2
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  command -p -- sync >/dev/null 2>&1 || return 3
)

RumiAI_atomic_publish()
(
  [ "$#" -eq 2 ] || return 2
  [ "${RumiAI_LOCK_HANDLE-}" = 9 ] || return 2

  RumiAI_PUBLISH_SOURCE_PARENT=$(RumiAI_path_parent "$1") || return 2
  RumiAI_PUBLISH_SOURCE_NAME=$(RumiAI_path_name "$1") || return 2
  RumiAI_PUBLISH_DEST_PARENT=$(RumiAI_path_parent "$2") || return 2
  RumiAI_PUBLISH_DEST_NAME=$(RumiAI_path_name "$2") || return 2

  RumiAI_PUBLISH_SOURCE_PARENT=$(RumiAI_path_canonicalize_existing "$RumiAI_PUBLISH_SOURCE_PARENT") || return 1
  RumiAI_PUBLISH_DEST_PARENT=$(RumiAI_path_canonicalize_existing "$RumiAI_PUBLISH_DEST_PARENT") || return 1
  [ "$RumiAI_PUBLISH_SOURCE_PARENT" = "$RumiAI_PUBLISH_DEST_PARENT" ] || return 2

  RumiAI_PUBLISH_SOURCE=$RumiAI_PUBLISH_SOURCE_PARENT/$RumiAI_PUBLISH_SOURCE_NAME
  RumiAI_PUBLISH_DEST=$RumiAI_PUBLISH_DEST_PARENT/$RumiAI_PUBLISH_DEST_NAME

  [ -d "$RumiAI_PUBLISH_SOURCE" ] && [ ! -L "$RumiAI_PUBLISH_SOURCE" ] || return 1
  [ ! -e "$RumiAI_PUBLISH_DEST" ] && [ ! -L "$RumiAI_PUBLISH_DEST" ] || return 1

  command -p -- mv "$RumiAI_PUBLISH_SOURCE" "$RumiAI_PUBLISH_DEST" || return 3
)
