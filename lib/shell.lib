RumiAI_SHELL_ERROR_LAUNCH=10

RumiAI_shell_read_value()
(
  [ "$#" -eq 1 ] || return 3

  RumiAI_shell_file=$1
  [ -f "$RumiAI_shell_file" ] || return 1
  [ -r "$RumiAI_shell_file" ] || return 2

  if ! exec 3< "$RumiAI_shell_file"
  then
    return 2
  fi

  RumiAI_shell_value=
  if ! IFS= read -r RumiAI_shell_value <&3
  then
    exec 3<&-
    return 3
  fi

  if [ -z "$RumiAI_shell_value" ]
  then
    exec 3<&-
    return 3
  fi

  RumiAI_shell_extra=
  if IFS= read -r RumiAI_shell_extra <&3 || [ -n "$RumiAI_shell_extra" ]
  then
    exec 3<&-
    return 3
  fi

  exec 3<&-
  printf -- '%s\n' "$RumiAI_shell_value"
)

RumiAI_shell()
{
  RumiAI_shell_conf_dir=$RumiAI_CONF_DIR/shell
  RumiAI_shell_default_file=$RumiAI_shell_conf_dir/default
  RumiAI_shell_requested=bash

  if [ -f "$RumiAI_shell_default_file" ]
  then
    if ! RumiAI_shell_requested=$(RumiAI_shell_read_value "$RumiAI_shell_default_file")
    then
      log warn shell default-config-invalid path "$RumiAI_shell_default_file"
      RumiAI_shell_requested=bash
    fi
  fi

  case $RumiAI_shell_requested in
    bash)
      if command -v -- bash >/dev/null 2>&1
      then
        RumiAI_shell_rc=$RumiAI_shell_conf_dir/bashrc

        BASH_SILENCE_DEPRECATION_WARNING=1
        export BASH_SILENCE_DEPRECATION_WARNING

        if [ -f "$RumiAI_shell_rc" ] && [ -r "$RumiAI_shell_rc" ]
        then
          exec bash --noprofile --rcfile "$RumiAI_shell_rc" -i
        fi

        PS1='[RumiAI] \u@\h:\w \$ '
        export PS1
        exec bash --noprofile --norc -i
      fi

      log warn shell fallback requested bash selected sh
      ;;

    sh)
      ;;

    *)
      log warn shell unsupported requested "$RumiAI_shell_requested" selected sh
      ;;
  esac

  RumiAI_shell_rc=$RumiAI_shell_conf_dir/shrc

  if [ -f "$RumiAI_shell_rc" ] && [ -r "$RumiAI_shell_rc" ]
  then
    ENV=$RumiAI_shell_rc
    export ENV
  else
    unset -v ENV
    PS1='[RumiAI] $ '
    export PS1
  fi

  if ! RumiAI_shell_sh=$(command -p -v sh 2>/dev/null)
  then
    log error shell launch-failed requested sh
    return "$RumiAI_SHELL_ERROR_LAUNCH"
  fi

  exec "$RumiAI_shell_sh" -i

  log error shell launch-failed requested sh
  return "$RumiAI_SHELL_ERROR_LAUNCH"
}
