#!/bin/sh

#-------------------------------------------------------------------------------
# FATAL ERROR FUNCTION
#-------------------------------------------------------------------------------

RumiAI_fatal()
{
  if [ -n "$2" ]
  then
    printf -- '%s\n' "$2" >&2
  fi

  case "$1" in
    *[!0-9]* | "")
      exit 1
      ;;
    *)
      exit $1
      ;;
  esac
}

#-------------------------------------------------------------------------------
# CANONICALIZE EXISTING PATH FUNCTION
#-------------------------------------------------------------------------------

# RumiAI_path_canonicalize_existing <path>
# returns a canonicalized version of <path>, return error if does not exist
RumiAI_path_canonicalize_existing()
(
  if [ ! "$#" -eq 1 ] || [ ! -e "$1" ] || ! RumiAI_path_output="$(command -p -- realpath -- "$1" 2>/dev/null)x"
  then
    return 1
  fi

  RumiAI_path_output="${RumiAI_path_output%x}"

  [ -e "$RumiAI_path_output" ] || return 1
  printf -- '%s\n' "$RumiAI_path_output"
)

#-------------------------------------------------------------------------------
# ROOT RESOLUTION
#-------------------------------------------------------------------------------

# error codes
RumiAI_FATAL_EXIT_CODE=1

# if invoked by PATH search, then acquire path used
case $0 in
  */*)
    RumiAI_BOOTSTRAP_BIN=$0
    ;;
  *)
    RumiAI_BOOTSTRAP_BIN=$(command -v -- "$0" 2>/dev/null) || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_BIN_RESOLUTION_ERROR'
    ;;
esac

# canonicalize the path of this script
RumiAI_BOOTSTRAP_BIN=$(RumiAI_path_canonicalize_existing "$RumiAI_BOOTSTRAP_BIN") || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_REALPATH_ERROR'

# check that it is really a file
[ -f "$RumiAI_BOOTSTRAP_BIN" ] || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_BIN_ERROR'

# extract root
RumiAI_ROOT=${RumiAI_BOOTSTRAP_BIN%/*}
[ -n "$RumiAI_ROOT" ] || RumiAI_ROOT=/

# check can cd into it
(cd -- "$RumiAI_ROOT" 2>/dev/null) || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_ROOT_ERROR'

# export root
export -- RumiAI_BOOTSTRAP_BIN RumiAI_ROOT

readonly -- RumiAI_BOOTSTRAP_BIN RumiAI_ROOT

#-------------------------------------------------------------------------------
# FUNDAMENTAL SYSTEM DIRECTORIES
#-------------------------------------------------------------------------------

# set values
RumiAI_BIN_DIR=$RumiAI_ROOT/bin
RumiAI_LIB_DIR=$RumiAI_ROOT/lib
RumiAI_CONF_DIR=$RumiAI_ROOT/conf
RumiAI_LANG_DIR=$RumiAI_ROOT/lang

# export vars
export -- \
  RumiAI_BIN_DIR \
  RumiAI_LIB_DIR \
  RumiAI_CONF_DIR \
  RumiAI_LANG_DIR

readonly -- \
  RumiAI_BIN_DIR \
  RumiAI_LIB_DIR \
  RumiAI_CONF_DIR \
  RumiAI_LANG_DIR

#-------------------------------------------------------------------------------
# LANG
#-------------------------------------------------------------------------------

# conf files
RumiAI_CONF_FILE_LANG_LANGUAGE=$RumiAI_CONF_DIR/lang/language
RumiAI_CONF_FILE_LANG_TEXT_ENCODING=$RumiAI_CONF_DIR/lang/text-encoding

# set var - language
if ! IFS= read -r RumiAI_LANGUAGE < "$RumiAI_CONF_FILE_LANG_LANGUAGE"
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_LANG_LANGUAGE_LOAD_ERROR' >&2
  RumiAI_LANGUAGE=en_US
fi

# set var - text encoding
if ! IFS= read -r RumiAI_TEXT_ENCODING < "$RumiAI_CONF_FILE_LANG_TEXT_ENCODING"
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_LANG_TEXT_ENCODING_LOAD_ERROR' >&2
  RumiAI_TEXT_ENCODING=UTF-8
fi

# supported encodings
case $RumiAI_TEXT_ENCODING in
  UTF-8)
    :
    ;;
  *)
    RumiAI_TEXT_ENCODING=UTF-8
    ;;
esac

# unset variables
unset -v -- RumiAI_CONF_FILE_LANG_LANGUAGE RumiAI_CONF_FILE_LANG_TEXT_ENCODING

# export variables
export -- RumiAI_LANGUAGE RumiAI_TEXT_ENCODING

#-------------------------------------------------------------------------------
# LOGGER
#-------------------------------------------------------------------------------

# error codes
RumiAI_FATAL_EXIT_CODE=2

# load lib
command -- . "$RumiAI_LIB_DIR/log.lib" || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR'

#-------------------------------------------------------------------------------
# PLATFORM DETECTION
#-------------------------------------------------------------------------------

# error codes
RumiAI_FATAL_EXIT_CODE=3

RumiAI_PLATFORM_OS=$(command -p uname -s 2>/dev/null) || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_PLATFORM_ERROR'

case $RumiAI_PLATFORM_OS in
  Linux)
    RumiAI_PLATFORM_OS="linux"
    ;;
  Darwin)
    RumiAI_PLATFORM_OS="macos"
    ;;
  MINGW*|MSYS*|CYGWIN*)
    RumiAI_PLATFORM_OS="windows"
    ;;
  # *)
  #   RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_PLATFORM_ERROR'
  #   ;;
esac

RumiAI_PLATFORM_ARCH=$(command -p uname -m 2>/dev/null) || RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_PLATFORM_ERROR'

case $RumiAI_PLATFORM_ARCH in
  arm64|aarch64)
    RumiAI_PLATFORM_ARCH="arm64"
    ;;
  x86_64|amd64|AMD64)
    RumiAI_PLATFORM_ARCH="x86_64"
    ;;
  # *)
  #   RumiAI_fatal "$RumiAI_FATAL_EXIT_CODE" 'RumiAI_BOOTSTRAP_FATAL_PLATFORM_ERROR'
  #   ;;
esac

RumiAI_PLATFORM_NAME=$RumiAI_PLATFORM_OS-$RumiAI_PLATFORM_ARCH
RumiAI_PLATFORM_BIN_DIR=$RumiAI_BIN_DIR/@platforms/$RumiAI_PLATFORM_NAME

PATH=$RumiAI_PLATFORM_BIN_DIR:$RumiAI_BIN_DIR${PATH:+:$PATH}

export -- \
  RumiAI_PLATFORM_OS \
  RumiAI_PLATFORM_ARCH \
  RumiAI_PLATFORM_NAME \
  RumiAI_PLATFORM_BIN_DIR \
  PATH

readonly -- \
  RumiAI_PLATFORM_OS \
  RumiAI_PLATFORM_ARCH \
  RumiAI_PLATFORM_NAME \
  RumiAI_PLATFORM_BIN_DIR

#-------------------------------------------------------------------------------
# SHELL
#-------------------------------------------------------------------------------

# conf files
RumiAI_CONF_FILE_SHELL_DEFAULT=$RumiAI_CONF_DIR/shell/default

# set var - shell
if ! IFS= read -r RumiAI_SHELL < "$RumiAI_CONF_FILE_SHELL_DEFAULT"
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_SHELL_DEFAULT_LOAD_ERROR' >&2
  RumiAI_SHELL=sh
fi

if ! command -v -- "$RumiAI_SHELL" >/dev/null 2>&1
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_SHELL_DEFAULT_LOAD_ERROR' >&2
  RumiAI_SHELL=sh
fi

# unset variables
unset -v -- RumiAI_CONF_FILE_SHELL_DEFAULT

# export variables
export -- RumiAI_SHELL

#-------------------------------------------------------------------------------
# EXECUTE
#-------------------------------------------------------------------------------

unset -v -- RumiAI_FATAL_EXIT_CODE

if [ "$#" -eq 0 ]
then
  "$RumiAI_SHELL"
  exit $?
fi

# error codes
RumiAI_FATAL_EXIT_CODE=4

RumiAI_COMMAND_ENTRY=$1
shift

# set var - command
if ! RumiAI_COMMAND_BIN=$(RumiAI_path_canonicalize_existing "$RumiAI_COMMAND_ENTRY")
then
  log error bootstrap command-entry-resolution-failed path "$RumiAI_COMMAND_ENTRY"
  exit "$RumiAI_FATAL_EXIT_CODE"
fi

if [ ! -f "$RumiAI_COMMAND_BIN" ] || [ ! -r "$RumiAI_COMMAND_BIN" ] || [ "$RumiAI_COMMAND_BIN" = "$RumiAI_BOOTSTRAP_BIN" ]
then
  log error bootstrap invalid-command-entry path "$RumiAI_COMMAND_BIN"
  exit "$RumiAI_FATAL_EXIT_CODE"
fi

# export variables
export -- RumiAI_COMMAND_BIN
readonly -- RumiAI_COMMAND_BIN

# error codes - unset variables
unset -v -- RumiAI_FATAL_EXIT_CODE

. "$RumiAI_COMMAND_BIN"
exit $?
