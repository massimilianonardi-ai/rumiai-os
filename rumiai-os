#!/bin/sh

#-------------------------------------------------------------------------------
# FATAL ERROR FUNCTION
#-------------------------------------------------------------------------------

fatal()
{
  [ -n "$1" ] && printf -- '%s\n' "$1" >&2

  exit 1
}

#-------------------------------------------------------------------------------
# CANONICALIZE EXISTING PATH FUNCTION
#-------------------------------------------------------------------------------

readpathce()
{
  [ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || return 1

  # safeguard against invalid variable name: read will make entire script fail when passing an invalid variable name
  case "$1" in "" | [0-9]* | *[!a-zA-Z0-9_]*) return 2 ;; esac

  eval $1=''

  set -- "$1" "$(
    set -eu
    shift
    # if invoked by PATH search, then acquire path used, safeguard against paths with trailing newline (NB command -v always adds a newline)
    case $1 in */*) cmd="$1";; *) if [ -e "./$1" ] || [ -L "./$1" ]; then cmd="./$1"; else cmd="$(command -v -- "$1" 2>/dev/null; printf -- '%s' "x")"; cmd="${cmd%
x}"; fi;; esac
    [ -e "$cmd" ] || exit 1
    # resolve and canonicalize an existing path portably
    cmd="$(command -p -- realpath -- "$cmd" 2>/dev/null; printf -- '%s' "x")"
    cmd="${cmd%
x}"
    [ -e "$cmd" ] || exit 1
    printf -- '%s' "${cmd}x"
)"

  # safeguard here has no additional newlines, only the last character
  set -- "$1" "${2%x}"

  # safeguard against failed subshell: read will pass with zero return code, but its varible will be empty and path empty is an error
  [ -n "$2" ] || return 3

  eval $1='$2'
}

#-------------------------------------------------------------------------------
# ROOT RESOLUTION
#-------------------------------------------------------------------------------

# canonicalize the path of this script and check that it is really a file
readpathce "m_BOOTSTRAP_BIN" "$0" && [ -f "$m_BOOTSTRAP_BIN" ] || fatal 'bootstrap bin resolution error'

# extract root
m_ROOT=${m_BOOTSTRAP_BIN%/*}
[ -n "$m_ROOT" ] || m_ROOT=/

# check can cd into it
(cd -- "$m_ROOT" 2>/dev/null) || fatal 'bootstrap dir error'

# export root
export -- m_BOOTSTRAP_BIN m_ROOT

readonly -- m_BOOTSTRAP_BIN m_ROOT

#-------------------------------------------------------------------------------
# FUNDAMENTAL SYSTEM DIRECTORIES
#-------------------------------------------------------------------------------

# set values
m_BIN_DIR=$m_ROOT/bin
m_BIN_SYS_DIR=$m_BIN_DIR/sys
m_BIN_SYS_OSARCH_DIR=$m_BIN_DIR/sys-osarch
m_BIN_EXT_DIR=$m_ROOT/bin/ext
m_BIN_EXT_OSARCH_DIR=$m_ROOT/bin/ext-osarch
m_LIB_DIR=$m_ROOT/lib
m_CONF_DIR=$m_ROOT/conf
m_LANG_DIR=$m_ROOT/lang

# export vars
export -- \
  m_BIN_DIR \
  m_BIN_SYS_DIR \
  m_BIN_SYS_OSARCH_DIR \
  m_BIN_EXT_DIR \
  m_BIN_EXT_OSARCH_DIR \
  m_LIB_DIR \
  m_CONF_DIR \
  m_LANG_DIR

readonly -- \
  m_BIN_DIR \
  m_BIN_SYS_DIR \
  m_BIN_SYS_OSARCH_DIR \
  m_BIN_EXT_DIR \
  m_BIN_EXT_OSARCH_DIR \
  m_LIB_DIR \
  m_CONF_DIR \
  m_LANG_DIR

# set path
PATH=$m_BIN_SYS_OSARCH_DIR:$m_BIN_SYS_DIR:$m_BIN_EXT_OSARCH_DIR:$m_BIN_EXT_DIR${PATH:+:$PATH}

# export path
export -- PATH

#-------------------------------------------------------------------------------
# TEXT
#-------------------------------------------------------------------------------

# functions
is_integer()
{
  [ "$#" -eq 1 ] || return 1

  case "$1" in *[!0-9]* | "") return 2;; *) return 0;; esac
}

text_safe_id()
{
  [ "$#" -eq 1 ] || return 1

  case "$1" in
    # first character match
    [a-z0-9]*)
      # middle characters and final character exclusions
      case $1 in
        *[!a-z0-9._-]* | *[._-])
          return 1
          ;;
      esac
      ;;
    *)
      return 1
      ;;
  esac

  return 0
}

text_safe_id_case()
{
  [ "$#" -eq 1 ] || return 1

  case "$1" in
    # first character match
    [A-Za-z0-9]*)
      # middle characters and final character exclusions
      case $1 in
        *[!A-Za-z0-9._-]* | *[._-])
          return 1
          ;;
      esac
      ;;
    *)
      return 1
      ;;
  esac

  return 0
}

#-------------------------------------------------------------------------------
# LANG
#-------------------------------------------------------------------------------

# functions
lang()
(
  [ "$#" -eq 2 ] && case "${1}${2}" in [!a-z0-9]* | *[!a-z0-9._-]* | *[._-]) false;; esac || return 1

  lang_domain=$1
  lang_message_id=$2

  lang_message="$(command -p -- cat "$m_LANG_DIR/@current/$lang_domain/$lang_message_id" 2>/dev/null)"
  if [ "$?" != 0 ]
  then
    case "$m_LANGUAGE_FALLBACK" in [a-z][a-z]_[A-Z][A-Z]) true;; *) false;; esac && lang_message="$(command -p -- cat "$m_LANG_DIR/$m_LANGUAGE_FALLBACK/$lang_domain/$lang_message_id" 2>/dev/null)"
    if [ "$?" != 0 ]
    then
      lang_message="${lang_domain}.${lang_message_id}"
    fi
  fi

  printf -- '%s\n' "$lang_message"
)

# set var - language
m_LANGUAGE_FALLBACK=en_US

# set var - text encoding
m_TEXT_ENCODING=UTF-8

# export variables
export -- \
  m_LANGUAGE_FALLBACK \
  m_TEXT_ENCODING

#-------------------------------------------------------------------------------
# LOGGER
#-------------------------------------------------------------------------------

: "${m_LOG_LEVEL:=info}"

log_fields_valid()
(
  [ "$(( $# % 2 ))" -eq 0 ] || return 1

  while [ "$#" -gt 0 ]
  do
    text_safe_id "$1" || return 1
    shift 2
  done

  return 0
)

log()
(
  [ "$#" -ge 3 ] || return 1

  log_severity="$1"
  shift

  case "$log_severity" in
    fatal)
      log_priority=1
      ;;
    error)
      log_priority=2
      ;;
    warn)
      log_priority=3
      ;;
    info)
      log_priority=4
      ;;
    debug)
      log_priority=5
      ;;
    trace)
      log_priority=6
      ;;
    *)
      return 2
      ;;
  esac

  case "$m_LOG_LEVEL" in
    off | none)
      log_threshold="0"
      ;;
    fatal)
      log_threshold="1"
      ;;
    error)
      log_threshold="2"
      ;;
    warn)
      log_threshold="3"
      ;;
    info)
      log_threshold="4"
      ;;
    debug)
      log_threshold="5"
      ;;
    trace | all)
      log_threshold="6"
      ;;
    *)
      return 6
      ;;
  esac

  [ "$log_priority" -le "$log_threshold" ] || return 0

  log_domain=$1
  log_message_id=$2
  shift 2

  text_safe_id "$log_domain" || \
    return 3

  text_safe_id "$log_message_id" || \
    return 4

  log_fields_valid "$@" || return 5

  if ! log_message=$(lang "$log_domain" "$log_message_id")
  then
    log_message=$log_domain.$log_message_id
  fi

  if ! log_timestamp=$(command -p -- date '+%Y-%m-%dT%H:%M:%S' 2>/dev/null)
  then
    log_timestamp=-
  fi

  printf -- '[%s] [%s] [%s.%s] %s' \
    "$log_timestamp" \
    "$log_severity" \
    "$log_domain" \
    "$log_message_id" \
    "$log_message" >&2

  while [ "$#" -gt 0 ]
  do
    log_field_name=$1
    log_field_value=$2
    shift 2

    printf -- ' [%s="%s"]' \
      "$log_field_name" \
      "$log_field_value" >&2
  done

  printf -- '\n' >&2
)


fatal()
{
  case "$1" in *[!0-9]* | "") EXIT_CODE="1";; *) EXIT_CODE="$1"; shift;; esac

  log fatal "$@"

  exit "$EXIT_CODE"
}

#-------------------------------------------------------------------------------
# EXECUTE
#-------------------------------------------------------------------------------

# execute shell
if [ "$#" -eq 0 ]
then
  : "${SHELL:=sh}"
  printf -- '%s\n'  "$(tput setaf 2)$(tput bold)${SHELL} $(tput setaf 7)RumiAI$(tput sgr0)" >&2
  exec "${SHELL}"
fi

# execute command
if ! readpathce "COMMAND_BIN" "$1" || [ ! -f "$m_COMMAND_BIN" ] || [ ! -r "$m_COMMAND_BIN" ] || [ "$m_COMMAND_BIN" = "$m_BOOTSTRAP_BIN" ]
then
  log fatal filesystem path-invalid command-original "$1" command-resolved "$m_COMMAND_BIN"
  exit 1
fi
shift

# export variables
export -- m_COMMAND_BIN

readonly -- m_COMMAND_BIN

# execute command
. "$m_COMMAND_BIN"
exit $?
