#!/usr/bin/env m

case "${1-}" in
  check)
    shift
    [ "$#" -eq 0 ] || exit 2
    command -v shell >/dev/null 2>&1 || exit 3
    ;;
  prepare)
    shift
    [ "$#" -eq 0 ] || exit 2
    printf '%s\n' external > "$TESTLAB_RESOURCES_DIR/host" || exit 4
    printf '%s' "$TESTLAB_PROJECT_ROOT" > "$TESTLAB_CONTEXT_DIR/root" || exit 4
    ;;
  enter)
    shift
    [ "$#" -eq 0 ] || exit 2
    CDPATH= cd -P -- "$TESTLAB_PROJECT_ROOT" || exit 4
    command -- shell
    exit $?
    ;;
  cleanup)
    shift
    [ "$#" -eq 0 ] || exit 2
    ;;
  *)
    exit 2
    ;;
esac
